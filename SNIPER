  function xpThreshold(lvl){ return 400 + (lvl-1)*250; }

  function updateProfileUI(){
    let remaining = totalXP, lvl = 1, threshold = xpThreshold(1);
    while(remaining >= threshold && lvl < 9999){ remaining -= threshold; lvl++; threshold = xpThreshold(lvl); }
    const leveledUp = lvl > level;
    level = lvl;
    profileNameEl.textContent = playerName;
    profileLevelEl.textContent = 'LV ' + level;
    const pct = Math.min(100, Math.round((remaining/threshold)*100));
    xpFillEl.style.width = pct + '%';
    if(leveledUp) showLevelUpToast(level);
  }

  let toastQueue = [];
