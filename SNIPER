  function processToastQueue(){
    if(toastBusy || toastQueue.length === 0) return;
    toastBusy = true;
    levelToastEl.textContent = toastQueue.shift();
    levelToastEl.classList.add('show');
    setTimeout(()=>{
      levelToastEl.classList.remove('show');
      setTimeout(()=>{ toastBusy = false; processToastQueue(); }, 250);
    }, 2000);
  }
