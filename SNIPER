<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SNIPER — Aim Calibration</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --void:#0a0d10;
    --panel:#12181b;
    --panel-2:#171f23;
    --line: rgba(232,237,240,0.12);
    --accent:#ff6a1a;
    --accent-dim: rgba(255,106,26,0.35);
    --accent-2:#00d4ff;
    --success:#39ff88;
    --danger:#ff3b4e;
    --text:#e8edf0;
    --text-dim:#71808a;
    --font-display:'Rajdhani', sans-serif;
    --font-mono:'JetBrains Mono', monospace;
  }

  body.theme-light{
    --void:#f6f3ec;
    --panel:#ffffff;
    --panel-2:#efece2;
    --line: rgba(10,15,20,0.10);
    --accent-dim: rgba(255,106,26,0.22);
    --accent-2:#0091b5;
    --success:#1f9e5c;
    --danger:#d92d3f;
    --text:#12181b;
    --text-dim:#5c6670;
  }

  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{
    margin:0;
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0/48px 48px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0/48px 48px,
      var(--void);
    color:var(--text);
    font-family:var(--font-display);
    min-height:100vh;
    overflow-x:hidden;
  }

  .scanlines{
    position:fixed; inset:0; pointer-events:none; z-index:50;
    background: repeating-linear-gradient(rgba(255,255,255,0.025) 0px, rgba(255,255,255,0.025) 1px, transparent 1px, transparent 3px);
    mix-blend-mode: overlay;
    opacity:.5;
  }
  body.theme-light .scanlines{ opacity:.12; }

  #app{ position:relative; min-height:100vh; }

  .ai-badge{
    position:fixed; top:16px; left:50%; transform:translateX(-50%);
    z-index:60;
    font-family:var(--font-mono); font-size:10px; letter-spacing:.2em;
    color:var(--text-dim); text-transform:uppercase;
    padding:6px 14px;
    background:var(--panel);
  }
  .ai-badge span{ color:var(--accent-2); }
  @media (max-width:520px){
    .ai-badge{ font-size:9px; padding:5px 10px; }
  }

  .credit-badge{
    position:fixed; bottom:16px; left:50%; transform:translateX(-50%);
    z-index:60;
    font-family:var(--font-mono); font-size:10px; letter-spacing:.14em;
    color:var(--text-dim); text-transform:uppercase;
    padding:6px 14px;
    background:var(--panel);
  }
  .credit-badge span{ color:var(--accent); }
  @media (max-width:520px){
    .credit-badge{ font-size:9px; padding:5px 10px; }
  }

  .profile-chip{
    position:fixed; top:16px; left:16px; z-index:60;
    display:flex; align-items:center; gap:10px;
    padding:7px 14px;
    font-family:var(--font-mono);
  }
  .profile-name{
    font-size:11px; letter-spacing:.12em; color:var(--text);
    cursor:pointer; text-transform:uppercase; border-bottom:1px dashed var(--text-dim);
  }
  .profile-name:hover{ color:var(--accent-2); }
  .profile-name-input{
    font-family:var(--font-mono); font-size:11px; letter-spacing:.12em; text-transform:uppercase;
    background:var(--panel-2); color:var(--text); border:1px solid var(--accent-2); padding:2px 4px; width:90px;
  }
  .profile-level{ font-size:11px; font-weight:700; color:var(--accent); letter-spacing:.1em; }
  .xp-bar{ width:56px; height:5px; background:var(--panel-2); border:1px solid var(--line); }
  .xp-fill{ height:100%; width:0%; background:var(--accent-2); transition: width .3s ease; }
  @media (max-width:520px){
    .profile-chip{ font-size:10px; gap:7px; padding:6px 10px; }
    .xp-bar{ width:38px; }
  }

  .level-toast{
    position:fixed; top:60px; left:50%; transform:translateX(-50%) translateY(-8px);
    z-index:70; font-family:var(--font-mono); font-size:13px; letter-spacing:.14em;
    color:var(--void); background:var(--accent-2); padding:8px 18px;
    opacity:0; pointer-events:none; transition: opacity .25s ease, transform .25s ease;
    text-transform:uppercase; font-weight:700;
  }
  .level-toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }

  @keyframes rainbowPulse{
    0%{ box-shadow: inset 0 0 0 5px #ff2d55; }
    20%{ box-shadow: inset 0 0 0 5px #ff9500; }
    40%{ box-shadow: inset 0 0 0 5px #ffe000; }
    60%{ box-shadow: inset 0 0 0 5px #34e07a; }
    80%{ box-shadow: inset 0 0 0 5px #2d9cff; }
    100%{ box-shadow: inset 0 0 0 5px #b74dff; }
  }
  body.party::before{
    content:''; position:fixed; inset:0; pointer-events:none; z-index:90;
    animation: rainbowPulse 1s linear infinite;
  }
  @keyframes titleWobble{
    0%,100%{ transform:rotate(0deg); }
    25%{ transform:rotate(-3deg) scale(1.03); }
    75%{ transform:rotate(3deg) scale(1.03); }
  }
  .title.wobble{ animation: titleWobble 0.25s ease; }

  .settings-btn{
    position:fixed; top:16px; right:16px; z-index:60;
    font-size:18px; line-height:1; color:var(--text-dim);
    padding:8px 12px; background-color:var(--panel);
  }
  .settings-btn:hover{ color:var(--accent); }

  .fullscreen-btn{
    position:fixed; top:16px; right:64px; z-index:60;
    font-size:16px; line-height:1; color:var(--text-dim);
    padding:8px 12px; background-color:var(--panel);
  }
  .fullscreen-btn:hover{ color:var(--accent); }
  .fullscreen-btn.active{ color:var(--accent-2); }
  @media (max-width:520px){
    .fullscreen-btn{ right:60px; font-size:14px; padding:7px 10px; }
  }

  .help-btn{
    position:fixed; top:16px; right:112px; z-index:60;
    font-family:var(--font-mono); font-weight:700; font-size:14px; line-height:1; color:var(--text-dim);
    padding:8px 13px; background-color:var(--panel);
  }
  .help-btn:hover{ color:var(--accent); }
  @media (max-width:520px){
    .help-btn{ right:104px; font-size:12px; padding:7px 11px; }
  }

  .settings-overlay{
    position:fixed; inset:0; z-index:100;
    background:rgba(0,0,0,.6);
    display:none; align-items:center; justify-content:center;
    padding:20px;
  }
  .settings-overlay.show{ display:flex; }
  .settings-panel{
    width:100%; max-width:340px;
    background-color:var(--panel);
    padding:26px 24px;
  }
  .settings-header{
    display:flex; justify-content:space-between; align-items:center;
    font-family:var(--font-mono); font-size:13px; letter-spacing:.18em; color:var(--text);
    margin-bottom:22px; text-transform:uppercase;
  }
  .settings-close{
    background:transparent; color:var(--text-dim); font-size:22px; line-height:1; padding:0 4px;
  }
  .settings-close:hover{ color:var(--text); }
  .settings-row{ margin-bottom:20px; }
  .settings-row:last-child{ margin-bottom:0; }

  .login-quick{ display:flex; gap:6px; flex-wrap:wrap; margin-bottom:8px; }
  .login-quick-btn{
    flex:1; min-width:70px; padding:8px 0; font-family:var(--font-mono); font-size:11px;
    letter-spacing:.06em; color:var(--text-dim); background:var(--panel-2); border:1px solid var(--line);
  }
  .login-quick-btn:hover{ color:var(--text); border-color:var(--accent-2); }
  .login-quick-btn.active{ color:var(--accent-2); border-color:var(--accent-2); }
  .login-error{ color:var(--danger); font-family:var(--font-mono); font-size:11px; min-height:14px; margin:0 0 8px; }
  .login-note{
    display:none; font-family:var(--font-mono); font-size:10px; line-height:1.5; color:var(--text-dim);
    margin:0 0 10px; padding:8px 10px; background:var(--panel-2); border-left:2px solid var(--accent-2);
  }
  .login-note.show{ display:block; }
  .login-actions-row{ display:flex; gap:8px; }
  .login-actions-row .btn-ghost{ flex:1; }
  #createAccountToggleBtn.active{ color:var(--accent-2); border-color:var(--accent-2); }
  .settings-label{
    display:block; font-family:var(--font-mono); font-size:10px; letter-spacing:.14em;
    color:var(--text-dim); text-transform:uppercase; margin-bottom:9px;
  }
  .settings-label span{ color:var(--accent-2); }
  .settings-input{
    width:100%; font-family:var(--font-mono); font-size:13px; letter-spacing:.06em;
    background:var(--panel-2); color:var(--text); border:1px solid var(--line);
    padding:9px 12px; text-transform:uppercase;
  }
  .settings-btn-group{ display:flex; gap:8px; }
  .settings-opt-btn{
    flex:1; font-family:var(--font-mono); font-size:11px; letter-spacing:.1em;
    background:var(--panel-2); color:var(--text-dim); border:1px solid var(--line);
    padding:8px 0; text-transform:uppercase;
  }
  .settings-opt-btn.active{ background:var(--accent); color:#1a0d05; border-color:var(--accent); }
  .settings-opt-btn:not(.active):hover{ color:var(--text); }
  #settingsSensSlider{
    width:100%; height:3px; -webkit-appearance:none; appearance:none;
    background:var(--line); outline:none; cursor:pointer;
  }
  #settingsSensSlider::-webkit-slider-thumb{
    -webkit-appearance:none; appearance:none; width:14px; height:14px; border-radius:50%;
    background:var(--accent); cursor:pointer;
  }
  #settingsSensSlider::-moz-range-thumb{
    width:14px; height:14px; border-radius:50%; border:none; background:var(--accent); cursor:pointer;
  }

  .briefing-overlay{
    position:fixed; inset:0; z-index:100;
    background:rgba(0,0,0,.6);
    display:none; align-items:center; justify-content:center;
    padding:20px;
  }
  .briefing-overlay.show{ display:flex; }
  .briefing-panel{
    width:100%; max-width:460px;
    background-color:var(--panel);
    padding:26px 24px;
  }
  .briefing-sub{
    font-family:var(--font-mono); font-size:11px; letter-spacing:.16em; color:var(--text-dim);
    text-transform:uppercase; margin:0 0 14px;
  }
  .difficulty-grid{ display:flex; flex-direction:column; gap:8px; }
  .difficulty-btn{
    display:flex; justify-content:space-between; align-items:center; gap:12px;
    padding:11px 16px; background-color:var(--panel-2); text-align:left;
  }
  .difficulty-btn:hover{ background-color:var(--panel); }
  .difficulty-btn.elite{ background-image:
      linear-gradient(var(--danger), var(--danger)), linear-gradient(var(--danger), var(--danger)),
      linear-gradient(var(--danger), var(--danger)), linear-gradient(var(--danger), var(--danger)),
      linear-gradient(var(--danger), var(--danger)), linear-gradient(var(--danger), var(--danger)),
      linear-gradient(var(--danger), var(--danger)), linear-gradient(var(--danger), var(--danger));
  }
  .diff-name{
    font-family:var(--font-mono); font-size:13px; letter-spacing:.08em; font-weight:700; color:var(--text);
  }
  .diff-hint{ font-family:var(--font-mono); font-size:11px; color:var(--text-dim); text-align:right; }
  .taunt-box{ display:none; margin-top:16px; }
  .taunt-box.show{ display:block; }
  .taunt-text{
    font-family:var(--font-mono); font-size:13px; line-height:1.6; color:var(--text);
    background-color:var(--panel-2); padding:14px 16px; margin:0 0 14px; border-left:2px solid var(--accent);
  }
  .briefing-actions{ display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end; }

  .egg-list{ list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:12px; }
  .egg-list li{ font-family:var(--font-mono); font-size:12px; color:var(--text-dim); line-height:1.5; }
  .egg-code{ color:var(--accent-2); letter-spacing:.04em; }

  .tutorial-body{ display:flex; flex-direction:column; gap:12px; max-height:60vh; overflow-y:auto; }
  .tutorial-body p{ margin:0; font-size:13px; line-height:1.6; color:var(--text-dim); }
  .tutorial-body strong{ color:var(--accent-2); letter-spacing:.04em; }


  .screen{ display:none; min-height:100vh; }
  .screen.active{ display:flex; flex-direction:column; }

  /* ---------- corner-bracket signature utility ---------- */
  .brackets{
    background-color:var(--panel);
    background-image:
      linear-gradient(var(--accent), var(--accent)), linear-gradient(var(--accent), var(--accent)),
      linear-gradient(var(--accent), var(--accent)), linear-gradient(var(--accent), var(--accent)),
      linear-gradient(var(--accent), var(--accent)), linear-gradient(var(--accent), var(--accent)),
      linear-gradient(var(--accent), var(--accent)), linear-gradient(var(--accent), var(--accent));
    background-repeat:no-repeat;
    background-size:16px 2px, 2px 16px, 16px 2px, 2px 16px, 16px 2px, 2px 16px, 16px 2px, 2px 16px;
    background-position:
      0 0, 0 0,
      100% 0, 100% 0,
      0 100%, 0 100%,
      100% 100%, 100% 100%;
    transition: background-size .18s ease;
  }
  .brackets.dim{
    background-image:
      linear-gradient(var(--text-dim), var(--text-dim)), linear-gradient(var(--text-dim), var(--text-dim)),
      linear-gradient(var(--text-dim), var(--text-dim)), linear-gradient(var(--text-dim), var(--text-dim)),
      linear-gradient(var(--text-dim), var(--text-dim)), linear-gradient(var(--text-dim), var(--text-dim)),
      linear-gradient(var(--text-dim), var(--text-dim)), linear-gradient(var(--text-dim), var(--text-dim));
  }

  .eyebrow{
    font-family:var(--font-mono);
    letter-spacing:.28em;
    font-size:11px;
    color:var(--accent);
    text-transform:uppercase;
    margin:0 0 14px;
  }

  button{ font-family:var(--font-display); cursor:pointer; border:none; }
  button:focus-visible, .mission-card:focus-visible{ outline:2px solid var(--accent-2); outline-offset:3px; }

  .btn-primary{
    background:var(--accent);
    color:#1a0d05;
    font-weight:700;
    font-size:16px;
    letter-spacing:.08em;
    padding:14px 34px;
    text-transform:uppercase;
    transition: transform .12s ease, background .12s ease;
  }
  .btn-primary:hover{ background:#ff7f3a; transform:translateY(-1px); }
  .btn-primary:disabled{ background:#3a2a1e; color:#6b5c4e; cursor:not-allowed; transform:none; }
  .btn-primary.btn-alt{ background:transparent; color:var(--accent); border:1px solid var(--accent); }
  .btn-primary.btn-alt:hover{ background:var(--accent-dim); color:var(--text); }
  .btn-primary.btn-alt:disabled{ background:transparent; color:#5a4535; border-color:#3a2a1e; }
  .entry-buttons{ display:flex; gap:14px; justify-content:center; flex-wrap:wrap; }

  .btn-ghost{
    background:transparent;
    color:var(--text-dim);
    border:1px solid var(--line);
    font-size:13px;
    letter-spacing:.08em;
    padding:10px 20px;
    text-transform:uppercase;
    transition: color .12s ease, border-color .12s ease;
  }
  .btn-ghost:hover{ color:var(--text); border-color:var(--accent-2); }

  /* ---------- INTRO ---------- */
  #screen-intro{ align-items:center; justify-content:center; text-align:center; padding:24px; }
  .intro-wrap{ max-width:560px; }
  .title{
    font-size:clamp(56px, 12vw, 96px);
    font-weight:700;
    letter-spacing:.05em;
    margin:0;
    line-height:1;
    color:var(--text);
    text-shadow: 0 0 24px var(--accent-dim);
  }
  .tagline{ color:var(--text-dim); font-size:16px; margin:14px 0 30px; }
  .boot-log{
    font-family:var(--font-mono);
    font-size:12px;
    color:var(--accent-2);
    text-align:left;
    min-height:132px;
    background:var(--panel-2);
    border:1px solid var(--line);
    padding:16px 18px;
    margin-bottom:28px;
  }
  .boot-log div{ opacity:0; animation: fadeIn .15s forwards; margin-bottom:4px; }
  .boot-log .ok{ color:var(--success); }
  @keyframes fadeIn{ to{ opacity:1; } }

  /* ---------- HUB ---------- */
  #screen-hub{ padding:48px clamp(20px,6vw,64px); }
  .hub-header h2{ font-size:30px; letter-spacing:.06em; margin:0 0 6px; }
  .hub-sub{ color:var(--text-dim); font-family:var(--font-mono); font-size:13px; margin:0 0 36px; }
  .hub-section{ margin-bottom:40px; }
  .hub-tab-panel{ display:none; }
  .hub-tab-panel.active{ display:block; }
  .hub-tabs{
    display:flex; gap:10px; margin-bottom:32px; border-bottom:1px solid var(--line);
    max-width:1100px; flex-wrap:wrap;
  }
  .hub-tab-btn{
    background:transparent; border:none; color:var(--text-dim);
    font-family:var(--font-mono); font-size:12px; letter-spacing:.14em; text-transform:uppercase;
    padding:10px 4px; margin-bottom:-1px; border-bottom:2px solid transparent;
  }
  .hub-tab-btn:hover{ color:var(--text); }
  .hub-tab-btn.active{ color:var(--accent); border-bottom-color:var(--accent); }
  .hub-section-label{
    font-family:var(--font-mono); font-size:12px; letter-spacing:.18em; text-transform:uppercase;
    color:var(--accent-2); margin:0 0 16px; padding-bottom:10px; border-bottom:1px solid var(--line);
    max-width:1100px;
  }
  .mission-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(240px,1fr));
    gap:20px;
    max-width:1100px;
  }
  .mission-card{
    padding:22px;
    text-align:left;
    color:var(--text);
    display:flex;
    flex-direction:column;
    gap:10px;
    min-height:190px;
  }
  .mission-card .code{ font-family:var(--font-mono); font-size:11px; letter-spacing:.2em; color:var(--accent); text-transform:uppercase; }
  .hardcore-tag{ color:var(--danger); border:1px solid var(--danger); padding:1px 6px; letter-spacing:.1em; }

  .quest-list{ display:flex; flex-direction:column; gap:10px; max-width:1100px; }
  .quest-card{
    display:flex; align-items:center; justify-content:space-between; gap:16px;
    padding:14px 20px; flex-wrap:wrap;
  }
  .quest-card.done{ opacity:.55; }
  .quest-main{ display:flex; flex-direction:column; gap:3px; }
  .quest-name{ font-size:15px; letter-spacing:.03em; font-weight:600; }
  .quest-name .quest-check{ color:var(--success); margin-right:6px; }
  .quest-desc{ font-family:var(--font-mono); font-size:12px; color:var(--text-dim); }
  .quest-side{ display:flex; align-items:center; gap:12px; }
  .quest-xp{ font-family:var(--font-mono); font-size:12px; color:var(--accent-2); letter-spacing:.06em; }
  .quest-status{
    font-family:var(--font-mono); font-size:10px; letter-spacing:.14em; padding:4px 10px;
    border:1px solid var(--line); color:var(--text-dim); text-transform:uppercase;
  }
  .quest-status.complete{ color:var(--success); border-color:var(--success); }

  .quest-tier-label{
    font-family:var(--font-mono); font-size:11px; letter-spacing:.16em; color:var(--accent);
    text-transform:uppercase; margin:22px 0 10px;
  }
  .quest-tier-label:first-child{ margin-top:0; }
  .quest-tier-label.elite{ color:var(--danger); }
  .quest-card.elite .quest-xp{ color:var(--danger); }
  .brackets.elite{
    background-image:
      linear-gradient(var(--danger), var(--danger)), linear-gradient(var(--danger), var(--danger)),
      linear-gradient(var(--danger), var(--danger)), linear-gradient(var(--danger), var(--danger)),
      linear-gradient(var(--danger), var(--danger)), linear-gradient(var(--danger), var(--danger)),
      linear-gradient(var(--danger), var(--danger)), linear-gradient(var(--danger), var(--danger));
  }
  .quest-card.quest-locked .quest-name{ color:var(--text-dim); letter-spacing:.1em; }
  .mission-card h3{ font-size:22px; margin:0; letter-spacing:.03em; }
  .mission-card p{ font-size:13.5px; color:var(--text-dim); margin:0; flex-grow:1; line-height:1.5; }
  .mission-meta{ display:flex; justify-content:space-between; align-items:center; font-family:var(--font-mono); font-size:11px; color:var(--text-dim); margin-top:6px; }
  .mission-meta .best{ color:var(--accent-2); }
  .deploy-btn{
    background:transparent; border:1px solid var(--accent); color:var(--accent);
    font-family:var(--font-mono); font-size:12px; letter-spacing:.15em;
    padding:9px 0; text-transform:uppercase; margin-top:4px;
    transition: background .12s ease, color .12s ease;
  }
  .deploy-btn:hover{ background:var(--accent); color:#1a0d05; }

  /* ---------- GAME ---------- */
  #screen-game{ padding:20px clamp(16px,4vw,40px); }
  .hud-bar{
    display:flex; align-items:center; gap:clamp(14px,3vw,32px);
    padding:14px 22px; margin-bottom:16px;
    flex-wrap:wrap;
  }
  .hud-item{ display:flex; flex-direction:column; gap:2px; }
  .hud-label{ font-family:var(--font-mono); font-size:10px; letter-spacing:.18em; color:var(--text-dim); }
  .hud-value{ font-family:var(--font-mono); font-size:20px; font-weight:700; color:var(--text); }
  #hudTime{ color:var(--accent-2); }
  .hud-bar .btn-ghost{ margin-left:auto; }

  .canvas-wrap{ position:relative; height:min(60vh, 540px); min-height:360px; }
  #gameCanvas{ width:100%; height:100%; display:block; cursor:none; background:#171f23; }

  .countdown-overlay{
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
