  const sessionBest = {}; // id -> best score

  // ---------------- Quest tracking ----------------
  const trainingCompleted = new Set();
  const missionWon = {};
  const missionWinRemaining = {}; // id -> best time-remaining (ms) at moment of win
  let longRangeBestDistance = 0;
  let trackingBestLockPct = 0;
