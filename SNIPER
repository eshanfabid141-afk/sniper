  briefingOverlay.addEventListener('click', (e)=>{ if(e.target === briefingOverlay) closeBriefing(); });

  function buildMissionCard(m){
    const card = document.createElement('div');
    card.className = 'mission-card brackets';
    card.tabIndex = 0;
    const best = sessionBest[m.id] !== undefined ? sessionBest[m.id] : '--';
    card.innerHTML = `
      <span class="code">${m.code} — ${m.duration}s${m.hardcore ? ' <span class="hardcore-tag">HARDCORE</span>' : ''}</span>
      <h3>${m.name}</h3>
      <p>${m.desc}</p>
      <div class="mission-meta"><span>DURATION ${m.duration}s</span><span class="best">BEST ${best}</span></div>
      <button class="deploy-btn">DEPLOY</button>
    `;
    const deploy = ()=> openBriefing(m);
    card.querySelector('.deploy-btn').addEventListener('click', deploy);
    card.addEventListener('keypress', (e)=>{ if(e.key==='Enter') deploy(); });
    return card;
  }

  function renderHub(){
    const trainingGrid = document.getElementById('trainingGrid');
    const missionGrid = document.getElementById('missionGrid');
    trainingGrid.innerHTML = '';
    missionGrid.innerHTML = '';
    function isUnlocked(m){
      if(!m.hidden) return true;
      if(m.id === 'duckrange') return duckModeUnlocked;
      if(m.id === 'crossover') return crossoverUnlocked;
      return false;
    }
    MISSIONS.filter(m=>m.category==='training' && isUnlocked(m)).forEach(m=> trainingGrid.appendChild(buildMissionCard(m)));
    MISSIONS.filter(m=>m.category==='mission' && isUnlocked(m)).forEach(m=> missionGrid.appendChild(buildMissionCard(m)));
    renderQuestsList();
  }

  document.getElementById('quitBtn').addEventListener('click', ()=>{
    stopMission(false);
    enterHub(currentMission && currentMission.category === 'mission' ? 'missions' : 'training');
  });
  document.getElementById('hubBtn').addEventListener('click', ()=>{
    enterHub(currentMission && currentMission.category === 'mission' ? 'missions' : 'training');
  });
  document.getElementById('retryBtn').addEventListener('click', ()=>{ beginMission(currentBaseMission, currentDifficulty); });

  // ---------------- Game engine ----------------
  const canvas = document.getElementById('gameCanvas');
  const ctx = canvas.getContext('2d');
  const canvasWrap = document.querySelector('.canvas-wrap');

  let currentMission = null;
  let targets = [];
  let effects = []; // transient hit/miss flashes
  let score = 0, hits = 0, misses = 0, streak = 0, bestStreak = 0;
  let reactionTimes = [];
  let lockTime = 0, totalTrackTime = 0;
  let guards = [], boxes = [], vip = null, missionOutcome = null, missionFailReason = null, guardsEliminated = 0, boxesUsed = 0;
  let buildingFloors = [], sweepTarget = null, sweepGuards = [];
  let fallingSpawnedCount = 0, fallingHitsCount = 0, fallingMissCount = 0, fallingCurrent = null, fallingNextSpawnTime = 0, fallingDone = false;
  const FALLING_TOTAL = 30;
  let convoyLanes = [], convoyCars = [], convoySpawnCount = 0, convoyTargetAssignedAt = 0, convoyNextSpawnTime = 0, convoyResolved = false;
  let holdoutLives = 3, holdoutWave = 1, holdoutCap = 2, holdoutNextSpawnTime = 0;
  let missionStartTime = 0, lastFrame = 0, timeLeftSec = 0, lastDrawnSec = -1;
  let gameActive = false;
  let rafId = null;
  let mouse = {x:-999,y:-999};
  let scoped = false;
  let lastXpGain = 0;
  let sensitivity = 1.0;
  let duckModeUnlocked = false;
  let crossoverUnlocked = false;

  function resizeCanvas(){
    const rect = canvasWrap.getBoundingClientRect();
    canvas.width = rect.width;
    canvas.height = rect.height;
    mouse.x = Math.max(0, Math.min(canvas.width, mouse.x));
    mouse.y = Math.max(0, Math.min(canvas.height, mouse.y));
  }
  window.addEventListener('resize', ()=>{ if(screens.game.classList.contains('active')) resizeCanvas(); });

  window.addEventListener('mousemove', (e)=>{
    if(!screens.game.classList.contains('active')) return;
    const dx = e.movementX || 0;
    const dy = e.movementY || 0;
    mouse.x = Math.max(0, Math.min(canvas.width, mouse.x + dx*sensitivity));
    mouse.y = Math.max(0, Math.min(canvas.height, mouse.y + dy*sensitivity));
  });
  canvas.addEventListener('contextmenu', (e)=> e.preventDefault());
  canvas.addEventListener('mousedown', (e)=>{
    if(e.button === 2 && gameActive && currentMission && currentMission.scope){ scoped = true; }
  });
  window.addEventListener('mouseup', (e)=>{
    if(e.button === 2){ scoped = false; }
  });
  window.addEventListener('keydown', (e)=>{
    if((e.code === 'Space' || e.key === ' ') && gameActive && currentMission && currentMission.scope){
      e.preventDefault();
      scoped = true;
    }
  });
  window.addEventListener('keyup', (e)=>{
    if(e.code === 'Space' || e.key === ' '){ scoped = false; }
  });
  canvas.addEventListener('touchstart', (e)=>{
    if(gameActive && currentMission && currentMission.scope){ scoped = true; }
  }, {passive:true});
  canvas.addEventListener('touchend', ()=>{ setTimeout(()=>{ scoped = false; }, 400); });

  canvas.addEventListener('click', (e)=>{
    if(!gameActive || !currentMission) return;
    if(currentMission.type === 'tracking') return; // no clicking needed
    const cx = mouse.x, cy = mouse.y;
    if(currentMission.scope && !scoped){
      effects.push({x:cx,y:cy,time:performance.now(),color:'danger',text:'SCOPE IN FIRST'});
      return;
    }
    if(birthdayMode){ playBirthdayNote(); } else if(horrorMode){ AudioEngine.horrorShot(); } else { AudioEngine.shot(); }
    if(currentMission.type === 'vip'){ handleVipClick(cx, cy); return; }
    if(currentMission.type === 'sweep'){ handleSweepClick(cx, cy); return; }
    if(currentMission.type === 'falling'){ handleFallingClick(cx, cy); return; }
    if(currentMission.type === 'convoy'){ handleConvoyClick(cx, cy); return; }
    let hitIndex = -1;
    for(let i=0;i<targets.length;i++){
      const t = targets[i];
      const d = Math.hypot(cx-t.x, cy-t.y);
      if(d <= t.r){ hitIndex = i; break; }
    }
    if(hitIndex >= 0){
      const t = targets[hitIndex];
      const reaction = performance.now() - t.spawnTime;
      reactionTimes.push(reaction);
      hits++; streak++; bestStreak = Math.max(bestStreak, streak);
      let pts = currentMission.basePoints;
      if(currentMission.type === 'flick' && reaction < 350) pts += 60;
      if(currentMission.type === 'longrange'){ pts = Math.round(40 + t.distance/2); longRangeBestDistance = Math.max(longRangeBestDistance, t.distance); }
      score += pts;
      AudioEngine.hit();
      effects.push({x:t.x,y:t.y,time:performance.now(),color:'success',text: currentMission.type==='longrange' ? ('+'+pts) : null});
      respawnTarget(hitIndex);
    } else {
      misses++; streak = 0;
      AudioEngine.miss();
      effects.push({x:cx,y:cy,time:performance.now(),color:'danger'});
    }
  });

  function isHeadshot(entity, cx, cy){
    const s = entity.r/32;
    const headX = entity.x, headY = entity.y - 34*s, headR = 11*s;
    return Math.hypot(cx-headX, cy-headY) <= headR;
  }
  function isBodyHit(entity, cx, cy){
    return Math.hypot(cx-entity.x, cy-entity.y) <= entity.r*1.3;
  }

  function handleVipClick(cx, cy){
    const now = performance.now();
    const hardcore = !!currentMission.hardcore;

    // crates first (usually front-most / small)
    for(let i=0;i<boxes.length;i++){
      const b = boxes[i];
      if(!b.alive) continue;
      if(Math.hypot(cx-b.x, cy-b.y) <= b.r){
        b.alive = false;
        boxesUsed++;
        const blastRadius = 95;
        let cleared = 0;
        guards.forEach(g=>{
          if(g.alive && Math.hypot(g.x-b.x, g.y-b.y) <= blastRadius){
            g.alive = false;
            cleared++;
          }
        });
        hits += cleared; guardsEliminated += cleared;
        score += cleared * 60;
        AudioEngine.hit();
        effects.push({x:b.x,y:b.y,time:now,color:'success',text: cleared>0 ? ('BOOM +'+(cleared*60)) : 'BOOM', big:true});
        checkVipUnshield();
        return;
      }
    }
    // guards
    for(let i=0;i<guards.length;i++){
      const g = guards[i];
      if(!g.alive) continue;
      if(isBodyHit(g, cx, cy)){
        g.alive = false;
        hits++; streak++; bestStreak = Math.max(bestStreak, streak);
        guardsEliminated++;
        score += 80;
        AudioEngine.hit();
        effects.push({x:g.x,y:g.y,time:now,color:'success',text:'+80'});
        checkVipUnshield();
        return;
      }
    }
    // target
    if(vip && vip.alive && isBodyHit(vip, cx, cy)){
      if(vip.protected){
        effects.push({x:vip.x,y:vip.y,time:now,color:'danger',text:'PROTECTED'});
        if(hardcore){ failMission('SPOTTED'); } else { misses++; streak = 0; }
        return;
      }
      if(!isHeadshot(vip, cx, cy)){
        effects.push({x:vip.x,y:vip.y,time:now,color:'danger',text: hardcore ? 'CAUGHT' : 'BODY SHOT'});
        if(hardcore){ failMission('CAUGHT'); } else { misses++; streak = 0; }
        return;
      }
      vip.alive = false;
      hits++; streak++; bestStreak = Math.max(bestStreak, streak);
      const remainingMs = Math.max(0, currentMission.duration*1000 - (now - missionStartTime));
      const timeBonus = Math.round(remainingMs/50);
      score += 500 + timeBonus;
      missionOutcome = 'win';
      AudioEngine.hit();
      effects.push({x:vip.x,y:vip.y,time:now,color:'success',text:'TARGET DOWN'});
      finishMission();
      return;
    }
    // clean miss
    effects.push({x:cx,y:cy,time:now,color:'danger'});
    if(hardcore){ failMission('CAUGHT'); } else { misses++; streak = 0; }
  }

  function failMission(reason){
    misses++; streak = 0;
    missionOutcome = 'fail';
    missionFailReason = reason || 'CAUGHT';
    AudioEngine.caught();
    finishMission();
  }

  function handleSweepClick(cx, cy){
    const now = performance.now();
    for(let i=0;i<sweepGuards.length;i++){
      const g = sweepGuards[i];
      if(walkerVisible(g) && Math.hypot(cx-g.x, cy-g.y) <= g.r + 6){
        effects.push({x:g.x,y:g.y,time:now,color:'danger',text:'WRONG TARGET'});
        failMission('WRONG TARGET');
        return;
      }
    }
    if(sweepTarget && walkerVisible(sweepTarget)){
      const d = Math.hypot(cx-sweepTarget.x, cy-sweepTarget.y);
      if(d <= sweepTarget.r + 6){
        hits++; streak++; bestStreak = Math.max(bestStreak, streak);
        const remainingMs = Math.max(0, currentMission.duration*1000 - (now - missionStartTime));
        score += 400 + Math.round(remainingMs/40);
        missionOutcome = 'win';
        AudioEngine.hit();
        effects.push({x:sweepTarget.x,y:sweepTarget.y,time:now,color:'success',text:'TARGET DOWN'});
        finishMission();
        return;
      }
    }
    effects.push({x:cx,y:cy,time:now,color:'danger'});
    failMission('CAUGHT');
  }

  function checkVipUnshield(){
    if(vip && vip.protected && guards.every(g=>!g.alive)){
      vip.protected = false;
    }
  }

  function rand(min,max){ return min + Math.random()*(max-min); }

  function spawnPosition(radius){
    const margin = radius + 12;
    return {
      x: rand(margin, Math.max(margin+1, canvas.width - margin)),
      y: rand(margin, Math.max(margin+1, canvas.height - margin))
    };
  }

  function makeTarget(radius, lifetime){
    const pos = spawnPosition(radius);
    return { x:pos.x, y:pos.y, r:radius, spawnTime: performance.now(), lifetime: lifetime || null, vx:0, vy:0 };
  }

  function holdoutRadiusForDiff(diff){
    return Math.round(26 * diff.sizeMult);
  }
  function holdoutLifetimeForWave(wave, diff){
    return Math.round(Math.max(900, 2400 - wave*130) / diff.speedMult);
  }
  function updateHoldoutHud(){
    const el = document.getElementById('hudProgress');
    if(el) el.textContent = String(Math.max(0, holdoutLives));
  }

  function distanceToRadius(distance){
    return Math.max(13, Math.min(44, 50 - distance/16));
  }

  function makeLongRangeTarget(){
    const distance = Math.round(rand(150, 650));
    const diff = currentMission.difficulty;
    const radius = distanceToRadius(distance) * diff.sizeMult;
    const lifetime = Math.round(2200 / diff.speedMult);
    const t = makeTarget(radius, lifetime);
    t.distance = distance;
    t.silhouette = true;
    return t;
  }

  function respawnTarget(index){
    const m = currentMission;
    if(m.type === 'longrange'){
      let attempts = 0, nt;
      do{
        nt = makeLongRangeTarget();
        attempts++;
      } while(attempts < 8 && targets.some((t,i)=> i!==index && Math.hypot(t.x-nt.x,t.y-nt.y) < nt.r*2.4));
      targets[index] = nt;
      return;
    }
    if(m.type === 'holdout'){
      const radius = holdoutRadiusForDiff(m.difficulty);
      const lifetime = holdoutLifetimeForWave(holdoutWave, m.difficulty);
      let attempts = 0, nt;
      do{
        nt = makeTarget(radius, lifetime);
        attempts++;
      } while(attempts < 8 && targets.some((t,i)=> i!==index && Math.hypot(t.x-nt.x,t.y-nt.y) < radius*2.4));
      targets[index] = nt;
      return;
    }
    let radius = m.targetRadius;
    let lifetime = m.type === 'flick' || m.type === 'gridrush' ? m.targetLifetime : null;
    let attempts = 0;
    let nt;
    do{
      nt = makeTarget(radius, lifetime);
      attempts++;
    } while(attempts < 8 && targets.some((t,i)=> i!==index && Math.hypot(t.x-nt.x,t.y-nt.y) < radius*2.4));
    targets[index] = nt;
  }

  function initTargets(){
    targets = [];
    const m = currentMission;
    if(m.type === 'static'){
      targets.push(makeTarget(m.targetRadius, null));
    } else if(m.type === 'flick'){
      targets.push(makeTarget(m.targetRadius, m.targetLifetime));
    } else if(m.type === 'gridrush'){
      for(let i=0;i<3;i++) targets.push(makeTarget(m.targetRadius, m.targetLifetime));
    } else if(m.type === 'longrange'){
      targets.push(makeLongRangeTarget());
    } else if(m.type === 'vip'){
      initVipMission();
    } else if(m.type === 'sweep'){
      initBuildingMission();
    } else if(m.type === 'falling'){
      // state reset already handled in beginMission; first spawn scheduled via nextSpawnTime
      fallingNextSpawnTime = performance.now() + 400;
    } else if(m.type === 'convoy'){
      initConvoyMission();
    } else if(m.type === 'holdout'){
      const radius = holdoutRadiusForDiff(m.difficulty);
      const lifetime = holdoutLifetimeForWave(1, m.difficulty);
      for(let i=0;i<2;i++) targets.push(makeTarget(radius, lifetime));
      holdoutNextSpawnTime = performance.now() + 800;
    } else if(m.type === 'tracking'){
      const t = makeTarget(m.targetRadius, null);
      const angle = rand(0, Math.PI*2);
      const speed = 0.14 * m.difficulty.speedMult; // px/ms
      t.vx = Math.cos(angle)*speed;
      t.vy = Math.sin(angle)*speed;
      targets.push(t);
    }
  }

  function spawnNonOverlapping(radius, placed){
    let attempts = 0, pos;
    do{
      pos = spawnPosition(radius);
      attempts++;
    } while(attempts < 12 && placed.some(e => Math.hypot(e.x-pos.x, e.y-pos.y) < (radius+e.r+18)));
    return pos;
  }

  function initVipMission(){
    const diff = currentMission.difficulty;
    const guardCountMap = { xeasy:2, easy:3, medium:4, hard:5, extreme:6 };
    const guardCount = guardCountMap[diff.id] || 4;
    const guardR = Math.round(28 * diff.sizeMult);
    const boxR = Math.round(20 * diff.sizeMult);
    const vipR = Math.round(32 * diff.sizeMult);
    const placed = [];
    guards = [];
    for(let i=0;i<guardCount;i++){
      const pos = spawnNonOverlapping(guardR, placed);
      const g = {x:pos.x, y:pos.y, r:guardR, alive:true};
      guards.push(g); placed.push(g);
    }
    boxes = [];
    for(let i=0;i<2;i++){
      const pos = spawnNonOverlapping(boxR, placed);
      const b = {x:pos.x, y:pos.y, r:boxR, alive:true};
      boxes.push(b); placed.push(b);
    }
    const vpos = spawnNonOverlapping(vipR, placed);
    vip = {x:vpos.x, y:vpos.y, r:vipR, alive:true, protected:true};
  }

  function spawnWalker(margin){
    const diff = currentMission.difficulty;
    const fIdx = Math.floor(rand(0, buildingFloors.length));
    const floor = buildingFloors[fIdx];
    return {
      floorIndex: fIdx,
      x: rand(margin, canvas.width-margin),
      y: floor.y + floor.h/2,
      r: Math.min(floor.h*0.36, 24) * diff.sizeMult,
      speed: (0.05 + Math.random()*0.02) * diff.speedMult,
      dir: Math.random() < 0.5 ? 1 : -1
    };
  }

  function moveWalker(walker, dt, margin){
    walker.x += walker.dir * walker.speed * dt;
    if(walker.x < margin || walker.x > canvas.width - margin){
      walker.x = Math.max(margin, Math.min(canvas.width - margin, walker.x));
      if(buildingFloors.length > 1 && Math.random() < 0.4){
        let nf;
        do{ nf = Math.floor(rand(0, buildingFloors.length)); } while(nf === walker.floorIndex);
        walker.floorIndex = nf;
        walker.y = buildingFloors[nf].y + buildingFloors[nf].h/2;
        walker.x = walker.dir > 0 ? margin : canvas.width - margin;
      }
      walker.dir *= -1;
    }
  }

  function walkerVisible(walker){
    const floor = buildingFloors[walker.floorIndex];
    if(!floor) return false;
    return floor.windows.some(w => walker.x >= w.x && walker.x <= w.x + w.w);
  }

  function initConvoyMission(){
    const diff = currentMission.difficulty;
    convoyLanes = [
      { y: canvas.height*0.30, r:20*diff.sizeMult, speed:0.075*diff.speedMult, dir:1 },
      { y: canvas.height*0.55, r:24*diff.sizeMult, speed:0.06*diff.speedMult, dir:-1 },
      { y: canvas.height*0.80, r:28*diff.sizeMult, speed:0.05*diff.speedMult, dir:1 },
    ];
    convoyCars = [];
    convoySpawnCount = 0;
    convoyTargetAssignedAt = Math.floor(rand(3, 8));
    convoyResolved = false;
    convoyNextSpawnTime = performance.now() + 500;
  }

  function spawnConvoyCar(now){
    convoySpawnCount++;
    const lane = convoyLanes[Math.floor(rand(0, convoyLanes.length))];
    const isTarget = convoySpawnCount === convoyTargetAssignedAt;
    const car = {
      lane, y: lane.y, r: lane.r,
      x: lane.dir > 0 ? -lane.r-20 : canvas.width+lane.r+20,
      dir: lane.dir, speed: lane.speed * (0.85 + Math.random()*0.3),
      isTarget,
      peeking: false,
      nextToggleTime: now + rand(500, 1400)
    };
    convoyCars.push(car);
    convoyNextSpawnTime = now + rand(900, 1500);
  }

  function handleConvoyClick(cx, cy){
    const now = performance.now();
    for(let i=0;i<convoyCars.length;i++){
      const car = convoyCars[i];
      if(!car.peeking) continue;
      const headY = car.y + carHeadOffset(car);
      const d = Math.hypot(cx-car.x, cy-headY);
      if(d <= car.r*0.5){
        if(car.isTarget){
          hits++; streak++; bestStreak = Math.max(bestStreak, streak);
          const remainingMs = Math.max(0, currentMission.duration*1000 - (now - missionStartTime));
          score += 450 + Math.round(remainingMs/45);
          missionOutcome = 'win';
          convoyResolved = true;
          AudioEngine.hit();
          effects.push({x:car.x, y:headY, time:now, color:'success', text:'TARGET DOWN'});
          finishMission();
        } else {
          effects.push({x:car.x, y:headY, time:now, color:'danger', text:'INNOCENT HIT'});
          failMission('INNOCENT HIT');
        }
        return;
      }
    }
    effects.push({x:cx, y:cy, time:now, color:'danger'});
    failMission('CAUGHT');
  }

  function updateFallingHud(){
    const el = document.getElementById('hudProgress');
    if(el) el.textContent = (fallingHitsCount + fallingMissCount) + '/' + FALLING_TOTAL;
  }

  function spawnFallingTarget(now){
    fallingSpawnedCount++;
    const diff = currentMission.difficulty;
    const r = 26 * diff.sizeMult;
    const x = rand(r+24, canvas.width - r - 24);
    const startY = -r - 10;
    const endY = canvas.height + r + 10;
    const fallDuration = Math.max(950, 2000 - fallingSpawnedCount*22) / diff.speedMult;
    fallingCurrent = { x, y:startY, startY, endY, r, spawnTime: now, fallDuration, resolved:false };
  }

  function handleFallingClick(cx, cy){
    const now = performance.now();
    if(fallingCurrent && !fallingCurrent.resolved){
      const t = fallingCurrent;
      const d = Math.hypot(cx-t.x, cy-t.y);
      if(d <= t.r){
        t.resolved = true;
        hits++; streak++; bestStreak = Math.max(bestStreak, streak);
        fallingHitsCount++;
        reactionTimes.push(now - t.spawnTime);
        score += 120;
        AudioEngine.hit();
        effects.push({x:t.x, y:t.y, time:now, color:'success', text:'+120'});
        fallingCurrent = null;
        fallingNextSpawnTime = now + 300;
        updateFallingHud();
        return;
      }
      t.resolved = true;
      misses++; streak = 0;
      fallingMissCount++;
      AudioEngine.miss();
      effects.push({x:cx, y:cy, time:now, color:'danger'});
      fallingCurrent = null;
      fallingNextSpawnTime = now + 350;
      updateFallingHud();
      return;
    }
    misses++; streak = 0;
    effects.push({x:cx, y:cy, time:now, color:'danger'});
  }

  function initBuildingMission(){
    const rows = 3, winCount = 4, margin = 30, floorGap = 16, wallGap = 22;
    const areaH = canvas.height - margin*2;
    const floorH = (areaH - floorGap*(rows-1)) / rows;
    const usableW = canvas.width - margin*2 - wallGap*(winCount-1);
    const winW = usableW / winCount;
    buildingFloors = [];
    for(let r=0; r<rows; r++){
      const y = margin + r*(floorH+floorGap);
      const windows = [];
      for(let c=0; c<winCount; c++){
        const roll = Math.random();
        const lit = roll < 0.32 ? 'warm' : roll < 0.42 ? 'cool' : null;
        windows.push({
          x: margin + c*(winW+wallGap), w: winW,
          lit, hasAC: Math.random() < 0.3, hasBlinds: Math.random() < 0.4
        });
      }
      buildingFloors.push({ y, h: floorH, windows });
    }
    sweepTarget = spawnWalker(margin);
    const guardCountMap = { xeasy:1, easy:1, medium:2, hard:3, extreme:4 };
    const guardCount = guardCountMap[currentMission.difficulty.id] || 2;
    sweepGuards = [];
    for(let i=0;i<guardCount;i++){ sweepGuards.push(spawnWalker(margin)); }
  }

  let currentBaseMission = null;
  let currentDifficulty = null;

  function beginMission(mission, difficulty){
    currentBaseMission = mission;
    currentDifficulty = difficulty || DIFFICULTIES[2];
    const diff = currentDifficulty;
    const baseRadius = mission.type==='flick' ? 24 : mission.type==='gridrush' ? 28 : mission.type==='tracking' ? 30 : mission.type==='holdout' ? 26 : 34;
    const baseLifetime = mission.type==='flick' ? 900 : mission.type==='gridrush' ? 2400 : null;
    currentMission = Object.assign({}, mission, {
      difficulty: diff,
      duration: Math.max(6, Math.round(mission.duration * diff.timeMult)),
      targetRadius: Math.round(baseRadius * diff.sizeMult),
      targetLifetime: baseLifetime ? Math.round(baseLifetime / diff.speedMult) : null,
      basePoints: mission.type==='flick' ? 140 : mission.type==='gridrush' ? 120 : mission.type==='holdout' ? 90 : 100
    });
    score=0; hits=0; misses=0; streak=0; bestStreak=0; reactionTimes=[]; lockTime=0; totalTrackTime=0; effects=[];
    guards=[]; boxes=[]; vip=null; missionOutcome=null; missionFailReason=null; guardsEliminated=0; boxesUsed=0;
    buildingFloors=[]; sweepTarget=null; sweepGuards=[];
    fallingSpawnedCount=0; fallingHitsCount=0; fallingMissCount=0; fallingCurrent=null; fallingNextSpawnTime=0; fallingDone=false;
    convoyLanes=[]; convoyCars=[]; convoySpawnCount=0; convoyTargetAssignedAt=0; convoyNextSpawnTime=0; convoyResolved=false;
    holdoutLives=3; holdoutWave=1; holdoutCap=2; holdoutNextSpawnTime=0;
    scoped = false;
    document.getElementById('hudMissionName').textContent = currentMission.name + ' [' + diff.label + ']';
    document.getElementById('hudAccLabel').textContent = currentMission.type==='tracking' ? 'LOCK' : 'ACC';
    const showProgress = currentMission.type==='falling' || currentMission.type==='holdout';
    document.getElementById('hudProgressItem').style.display = showProgress ? 'flex' : 'none';
    document.getElementById('hudProgressLabel').textContent = currentMission.type==='holdout' ? 'LIVES' : 'TARGETS';
    document.getElementById('hudProgress').textContent = currentMission.type==='holdout' ? String(holdoutLives) : ('0/' + FALLING_TOTAL);
    document.getElementById('hudScore').textContent = '0';
    document.getElementById('hudAcc').textContent = '0%';
    document.getElementById('hudTime').textContent = String(currentMission.duration);
    document.getElementById('gameHint').textContent = currentMission.hint;
    showScreen('game');
    resizeCanvas();
    mouse.x = canvas.width / 2;
    mouse.y = canvas.height / 2;
    initTargets();
    runCountdown(3, ()=> startLoop());
  }

  function runCountdown(n, done){
    const overlay = document.getElementById('countdownOverlay');
    const num = document.getElementById('countdownNum');
    overlay.classList.add('show');
    num.textContent = n > 0 ? n : 'GO';
    if(n <= 0){
      AudioEngine.go();
      setTimeout(()=>{ overlay.classList.remove('show'); done(); }, 450);
      return;
    }
    AudioEngine.countdown();
    setTimeout(()=> runCountdown(n-1, done), 650);
  }

  function startLoop(){
    gameActive = true;
    missionStartTime = performance.now();
    lastFrame = missionStartTime;
    lastDrawnSec = -1;
    timeLeftSec = currentMission.duration;
    rafId = requestAnimationFrame(tick);
  }

  function stopMission(){
    gameActive = false;
    if(rafId) cancelAnimationFrame(rafId);
    rafId = null;
  }

  function tick(now){
    if(!gameActive) return;
    const dt = now - lastFrame;
    lastFrame = now;
    const elapsed = now - missionStartTime;
    const remainingMs = currentMission.duration*1000 - elapsed;

    if(remainingMs <= 0){
      finishMission();
      return;
    }
    const secLeft = Math.ceil(remainingMs/1000);
    if(secLeft !== lastDrawnSec){
      lastDrawnSec = secLeft;
      document.getElementById('hudTime').textContent = String(secLeft);
    }

    updateMission(dt, now);
    draw(now);
    rafId = requestAnimationFrame(tick);
  }

  function updateMission(dt, now){
    const m = currentMission;
    if(m.type === 'flick' || m.type === 'gridrush' || m.type === 'longrange'){
      for(let i=0;i<targets.length;i++){
        const t = targets[i];
        if(t.lifetime && (now - t.spawnTime) > t.lifetime){
          misses++; streak = 0;
          effects.push({x:t.x,y:t.y,time:now,color:'danger'});
          respawnTarget(i);
        }
      }
    } else if(m.type === 'tracking'){
      const t = targets[0];
      t.x += t.vx*dt; t.y += t.vy*dt;
      const margin = t.r+8;
      if(t.x < margin){ t.x = margin; t.vx = Math.abs(t.vx); }
      if(t.x > canvas.width-margin){ t.x = canvas.width-margin; t.vx = -Math.abs(t.vx); }
      if(t.y < margin){ t.y = margin; t.vy = Math.abs(t.vy); }
      if(t.y > canvas.height-margin){ t.y = canvas.height-margin; t.vy = -Math.abs(t.vy); }
      // occasional gentle direction nudge
      if(Math.random() < 0.01){
        const angle = Math.atan2(t.vy,t.vx) + rand(-0.9,0.9);
        const speed = Math.hypot(t.vx,t.vy);
        t.vx = Math.cos(angle)*speed;
        t.vy = Math.sin(angle)*speed;
      }
      totalTrackTime += dt;
      const d = Math.hypot(mouse.x-t.x, mouse.y-t.y);
      if(d <= t.r){
        lockTime += dt;
        score += Math.round(dt/8);
      }
      const lockPct = totalTrackTime>0 ? Math.round((lockTime/totalTrackTime)*100) : 0;
      document.getElementById('hudAcc').textContent = lockPct+'%';
    } else if(m.type === 'sweep'){
      const margin = 30;
      moveWalker(sweepTarget, dt, margin);
      sweepGuards.forEach(g => moveWalker(g, dt, margin));
    } else if(m.type === 'falling'){
      if(!fallingCurrent && fallingSpawnedCount < FALLING_TOTAL && now >= fallingNextSpawnTime){
        spawnFallingTarget(now);
      }
      if(fallingCurrent && !fallingCurrent.resolved){
        const t = fallingCurrent;
        const progress = Math.min(1, (now - t.spawnTime) / t.fallDuration);
        t.y = t.startY + (t.endY - t.startY) * progress;
        if(progress >= 1){
          t.resolved = true;
          fallingMissCount++;
          misses++; streak = 0;
          effects.push({x:t.x, y:t.endY, time:now, color:'danger', text:'MISSED'});
          fallingCurrent = null;
          fallingNextSpawnTime = now + 350;
          updateFallingHud();
        }
      }
      if(fallingSpawnedCount >= FALLING_TOTAL && !fallingCurrent && !fallingDone){
        fallingDone = true;
        finishMission();
        return;
      }
    } else if(m.type === 'convoy'){
      if(!convoyResolved && now >= convoyNextSpawnTime){
        spawnConvoyCar(now);
      }
      let targetEscaped = false;
      convoyCars = convoyCars.filter(car=>{
        car.x += car.dir * car.speed * dt;
        if(now >= car.nextToggleTime){
          car.peeking = !car.peeking;
          const sMult = m.difficulty.speedMult;
          car.nextToggleTime = now + (car.peeking ? rand(500,750)/sMult : rand(700,1600));
        }
        const offscreen = car.dir > 0 ? car.x - car.r > canvas.width + 30 : car.x + car.r < -30;
        if(offscreen){
          if(car.isTarget && !convoyResolved) targetEscaped = true;
          return false;
        }
        return true;
      });
      if(targetEscaped && !convoyResolved){
        convoyResolved = true;
        missionOutcome = 'fail';
        missionFailReason = 'TARGET LOST';
        finishMission();
        return;
      }
    } else if(m.type === 'holdout'){
      const elapsed = now - missionStartTime;
      holdoutWave = 1 + Math.floor(elapsed/12000);
      holdoutCap = Math.min(6, 2 + holdoutWave);
      while(targets.length < holdoutCap){
        const radius = holdoutRadiusForDiff(m.difficulty);
        const lifetime = holdoutLifetimeForWave(holdoutWave, m.difficulty);
        targets.push(makeTarget(radius, lifetime));
      }
      if(now >= holdoutNextSpawnTime){
        holdoutNextSpawnTime = now + Math.max(280, 900 - holdoutWave*60);
      }
      for(let i=targets.length-1;i>=0;i--){
        const t = targets[i];
        if(t.lifetime && (now - t.spawnTime) > t.lifetime){
          holdoutLives--;
          AudioEngine.miss();
          effects.push({x:t.x, y:t.y, time:now, color:'danger', text:'BREACH'});
          updateHoldoutHud();
          if(holdoutLives <= 0){
            missionOutcome = 'fail';
            missionFailReason = 'OVERRUN';
            finishMission();
            return;
          }
          respawnTarget(i);
        }
      }
    }

    if(m.type !== 'tracking'){
      const total = hits+misses;
      const acc = total>0 ? Math.round((hits/total)*100) : 0;
      document.getElementById('hudAcc').textContent = acc+'%';
    }
    document.getElementById('hudScore').textContent = String(score);
  }

  function drawFigureSilhouette(x, y, r, fillColor, outlineColor){
    const s = r/32;
    ctx.fillStyle = fillColor;
    ctx.strokeStyle = outlineColor;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(x, y - 34*s, 11*s, 0, Math.PI*2);
    ctx.fill(); ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(x - 9*s, y - 22*s);
    ctx.quadraticCurveTo(x - 22*s, y - 20*s, x - 20*s, y + 4*s);
    ctx.quadraticCurveTo(x - 17*s, y + 30*s, x - 10*s, y + 40*s);
    ctx.lineTo(x + 10*s, y + 40*s);
    ctx.quadraticCurveTo(x + 17*s, y + 30*s, x + 20*s, y + 4*s);
    ctx.quadraticCurveTo(x + 22*s, y - 20*s, x + 9*s, y - 22*s);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
  }

  function carHeadOffset(car){
    return -car.r * 0.62;
  }

  function drawConvoyScene(now){
    // backdrop wall behind the street
    const bgGrad = ctx.createLinearGradient(0,0,0,canvas.height);
    bgGrad.addColorStop(0, '#14191d');
    bgGrad.addColorStop(1, '#1c2226');
    ctx.fillStyle = bgGrad;
    ctx.fillRect(0,0,canvas.width,canvas.height);

    convoyLanes.forEach(lane=>{
      const bandTop = lane.y - lane.r*1.5;
      const bandH = lane.r*2.6;
      ctx.fillStyle = '#22262a';
      ctx.fillRect(0, bandTop, canvas.width, bandH);
      ctx.strokeStyle = 'rgba(232,237,240,0.18)';
      ctx.lineWidth = 2;
      ctx.setLineDash([16,12]);
      ctx.beginPath();
      ctx.moveTo(0, lane.y + lane.r*0.9); ctx.lineTo(canvas.width, lane.y + lane.r*0.9);
      ctx.stroke();
      ctx.setLineDash([]);
    });

    convoyCars.forEach(car=> drawSideCar(car));
  }

  function drawSideCar(car){
    ctx.save();
    ctx.translate(car.x, car.y);
    const w = car.r*2.7, h = car.r*1.25;
    // ground shadow
    ctx.beginPath();
    ctx.ellipse(0, h*0.42, w*0.5, h*0.16, 0, 0, Math.PI*2);
    ctx.fillStyle = 'rgba(0,0,0,0.32)';
    ctx.fill();
    // side-profile body: lower box + cabin roofline
    ctx.fillStyle = '#2a2f33';
    ctx.strokeStyle = 'rgba(232,237,240,0.35)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(-w/2, h*0.18);
    ctx.lineTo(-w/2, -h*0.02);
    ctx.lineTo(-w*0.26, -h*0.58);
    ctx.lineTo(w*0.26, -h*0.58);
    ctx.lineTo(w/2, -h*0.02);
    ctx.lineTo(w/2, h*0.18);
    ctx.closePath();
    ctx.fill(); ctx.stroke();
    // side window band
    ctx.beginPath();
    ctx.moveTo(-w*0.2, -h*0.52);
    ctx.lineTo(w*0.2, -h*0.52);
    ctx.lineTo(w*0.13, -h*0.1);
    ctx.lineTo(-w*0.13, -h*0.1);
    ctx.closePath();
    ctx.fillStyle = car.peeking ? 'rgba(0,0,0,0.12)' : '#0c0f11';
    ctx.fill();
    // wheels
    ctx.fillStyle = '#0d0f10';
    ctx.beginPath(); ctx.arc(-w*0.28, h*0.18, h*0.22, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(w*0.28, h*0.18, h*0.22, 0, Math.PI*2); ctx.fill();
    // peeking occupant, head silhouette through the side window
    if(car.peeking){
      ctx.beginPath();
      ctx.arc(0, carHeadOffset(car), w*0.11, 0, Math.PI*2);
      ctx.fillStyle = car.isTarget ? '#ffd23d' : '#ff8a8a';
      ctx.fill();
    }
    ctx.restore();
  }

  function drawFallingScene(now){
    if(fallingCurrent){
      const t = fallingCurrent;
      ctx.strokeStyle = 'rgba(255,106,26,0.35)';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(t.x, Math.max(t.startY, t.y-42));
      ctx.lineTo(t.x, t.y-t.r);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(t.x, t.y, t.r, 0, Math.PI*2);
      ctx.fillStyle = 'rgba(255,106,26,0.16)';
      ctx.fill();
      ctx.lineWidth = 2.5;
      ctx.strokeStyle = '#ff6a1a';
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(t.x, t.y, t.r*0.32, 0, Math.PI*2);
      ctx.fillStyle = '#ff6a1a';
      ctx.fill();
    }
    ctx.font = '700 12px "JetBrains Mono", monospace';
    ctx.textAlign = 'right';
    ctx.fillStyle = 'rgba(232,237,240,0.55)';
    ctx.fillText((fallingHitsCount+fallingMissCount) + ' / ' + FALLING_TOTAL, canvas.width-14, 24);
  }

  function drawBuildingScene(now){
    // wall base with subtle vertical lighting gradient
    const wallGrad = ctx.createLinearGradient(0,0,canvas.width,0);
    wallGrad.addColorStop(0, '#221b16');
    wallGrad.addColorStop(0.5, '#1c1712');
    wallGrad.addColorStop(1, '#161210');
    ctx.fillStyle = wallGrad;
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // brick coursing: offset rows of subtle rectangles
    const brickH = 13, brickW = 34;
    ctx.strokeStyle = 'rgba(0,0,0,0.22)';
    ctx.lineWidth = 1;
    let row = 0;
    for(let y=6; y<canvas.height; y+=brickH){
      const offset = (row % 2 === 0) ? 0 : brickW/2;
      ctx.beginPath();
      ctx.moveTo(0,y); ctx.lineTo(canvas.width,y);
      ctx.stroke();
      for(let x=-brickW+offset; x<canvas.width; x+=brickW){
        ctx.beginPath();
        ctx.moveTo(x, y); ctx.lineTo(x, y+brickH);
        ctx.stroke();
      }
      row++;
    }

    // rooftop cornice above the top floor
    if(buildingFloors.length){
      const topY = buildingFloors[0].y - 18;
      ctx.fillStyle = '#0d0a08';
      ctx.fillRect(0, topY, canvas.width, 10);
      ctx.strokeStyle = 'rgba(0,0,0,0.4)';
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(0, topY+10); ctx.lineTo(canvas.width, topY+10); ctx.stroke();
    }

    buildingFloors.forEach((floor, fi)=>{
      ctx.font = '700 10px "JetBrains Mono", monospace';
      ctx.fillStyle = 'rgba(232,237,240,0.4)';
      ctx.textAlign = 'left';
      ctx.fillText('FLOOR ' + (buildingFloors.length - fi), 8, floor.y - 6);

      floor.windows.forEach(w=>{
        // lintel (header ledge above window)
        ctx.fillStyle = 'rgba(0,0,0,0.35)';
        ctx.fillRect(w.x-3, floor.y-4, w.w+6, 4);

        // glass / interior
        ctx.fillStyle = '#0a0d10';
        ctx.fillRect(w.x, floor.y, w.w, floor.h);

        if(w.lit === 'warm'){
          const glow = ctx.createLinearGradient(w.x, floor.y, w.x, floor.y+floor.h);
          glow.addColorStop(0, 'rgba(255,196,110,0.5)');
          glow.addColorStop(1, 'rgba(120,70,20,0.18)');
          ctx.fillStyle = glow;
          ctx.fillRect(w.x, floor.y, w.w, floor.h);
        } else if(w.lit === 'cool'){
          const glow = ctx.createLinearGradient(w.x, floor.y, w.x, floor.y+floor.h);
          glow.addColorStop(0, 'rgba(120,200,255,0.28)');
          glow.addColorStop(1, 'rgba(20,60,90,0.12)');
          ctx.fillStyle = glow;
          ctx.fillRect(w.x, floor.y, w.w, floor.h);
        } else {
          const glow = ctx.createLinearGradient(w.x, floor.y, w.x, floor.y+floor.h);
          glow.addColorStop(0, 'rgba(0,212,255,0.04)');
          glow.addColorStop(1, 'rgba(0,0,0,0)');
          ctx.fillStyle = glow;
          ctx.fillRect(w.x, floor.y, w.w, floor.h);
        }

        // blinds (a few horizontal slats near the top)
        if(w.hasBlinds){
          ctx.strokeStyle = 'rgba(10,13,16,0.55)';
          ctx.lineWidth = 2;
          for(let by=floor.y+5; by<floor.y+floor.h*0.42; by+=4){
            ctx.beginPath(); ctx.moveTo(w.x+2, by); ctx.lineTo(w.x+w.w-2, by); ctx.stroke();
          }
        }

        // frame
        ctx.strokeStyle = 'rgba(232,237,240,0.3)';
        ctx.lineWidth = 2;
        ctx.strokeRect(w.x, floor.y, w.w, floor.h);
        ctx.beginPath();
        ctx.moveTo(w.x + w.w/2, floor.y); ctx.lineTo(w.x + w.w/2, floor.y + floor.h);
        ctx.moveTo(w.x, floor.y + floor.h/2); ctx.lineTo(w.x + w.w, floor.y + floor.h/2);
        ctx.strokeStyle = 'rgba(232,237,240,0.12)';
        ctx.lineWidth = 1;
        ctx.stroke();

        // sill (ledge below window)
        ctx.fillStyle = 'rgba(232,237,240,0.18)';
        ctx.fillRect(w.x-4, floor.y+floor.h, w.w+8, 4);

        // AC unit on some windows
        if(w.hasAC){
          const acW = w.w*0.42, acH = 9;
          ctx.fillStyle = '#3a3f42';
          ctx.strokeStyle = 'rgba(0,0,0,0.4)';
          ctx.lineWidth = 1;
          ctx.fillRect(w.x+4, floor.y+floor.h-acH-2, acW, acH);
          ctx.strokeRect(w.x+4, floor.y+floor.h-acH-2, acW, acH);
        }
      });
    });

    sweepGuards.forEach(g=>{
      if(walkerVisible(g)){
        drawFigureSilhouette(g.x, g.y, g.r, '#241a1a', '#ff3b4e');
      }
    });

    if(sweepTarget && walkerVisible(sweepTarget)){
      drawFigureSilhouette(sweepTarget.x, sweepTarget.y, sweepTarget.r, '#332b16', '#ffd23d');
    }
  }

  function drawVipScene(now){
    // crates
    boxes.forEach(b=>{
      if(!b.alive) return;
      ctx.save();
      ctx.translate(b.x, b.y);
      ctx.fillStyle = '#241c14';
      ctx.strokeStyle = '#ff6a1a';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.rect(-b.r, -b.r, b.r*2, b.r*2);
      ctx.fill(); ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(-b.r, b.r); ctx.lineTo(b.r, -b.r);
      ctx.strokeStyle = 'rgba(255,106,26,0.55)';
      ctx.lineWidth = 3;
      ctx.stroke();
      ctx.font = '700 10px "JetBrains Mono", monospace';
      ctx.fillStyle = '#ff6a1a';
      ctx.textAlign = 'center';
      ctx.fillText('CHARGE', 0, 4);
      ctx.restore();
    });

    // guards
    guards.forEach(g=>{
      if(!g.alive) return;
      drawFigureSilhouette(g.x, g.y, g.r, '#241a1a', '#ff3b4e');
    });

    // target
    if(vip && vip.alive){
      const shielded = vip.protected;
      drawFigureSilhouette(vip.x, vip.y, vip.r, shielded ? '#242a2d' : '#332b16', shielded ? '#71808a' : '#ffd23d');
      ctx.font = '700 11px "JetBrains Mono", monospace';
      ctx.textAlign = 'center';
      if(shielded){
        ctx.fillStyle = '#71808a';
        ctx.fillText('PROTECTED', vip.x, vip.y - 58*(vip.r/32));
        ctx.beginPath();
        ctx.arc(vip.x, vip.y, vip.r+16, 0, Math.PI*2);
        ctx.setLineDash([4,4]);
        ctx.strokeStyle = 'rgba(113,128,138,0.45)';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.setLineDash([]);
      } else {
        const pulse = 0.5 + 0.5*Math.sin(now/220);
        ctx.fillStyle = '#ffd23d';
        ctx.fillText('TARGET', vip.x, vip.y - 58*(vip.r/32));
        ctx.beginPath();
        ctx.arc(vip.x, vip.y, vip.r+14+pulse*4, 0, Math.PI*2);
        ctx.strokeStyle = `rgba(255,210,61,${0.5+pulse*0.4})`;
        ctx.lineWidth = 2;
        ctx.stroke();
      }
    }
  }

  function randomGameLabel(){
    const labels = ['ROBLOX','GEOMETRY DASH','MINECRAFT'];
    return labels[Math.floor(Math.random()*labels.length)];
  }

  function drawCrossoverTarget(t, pulse){
    if(!t.label) t.label = randomGameLabel();
    ctx.save();
    ctx.translate(t.x, t.y);
    if(t.label === 'MINECRAFT') drawMinecraftBlock(t);
    else if(t.label === 'GEOMETRY DASH') drawGeometryDashIcon(t);
    else drawRobloxFigure(t);
    ctx.font = '700 9px "JetBrains Mono", monospace';
    ctx.fillStyle = '#fff';
    ctx.textAlign = 'center';
    ctx.fillText(t.label, 0, t.r+16);
    ctx.restore();
    if(t.lifetime){
      ctx.beginPath();
      ctx.arc(t.x, t.y, t.r+10, -Math.PI/2, -Math.PI/2 + pulse*Math.PI*2);
      ctx.strokeStyle = 'rgba(232,237,240,0.55)';
      ctx.lineWidth = 2;
      ctx.stroke();
    }
  }

  function drawMinecraftBlock(t){
    const s = t.r*0.85;
    // front face (dirt-brown, pixel speckled)
    ctx.fillStyle = '#7a5230';
    ctx.strokeStyle = '#3c2a17';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.rect(-s, -s*0.35, s*2, s*1.35);
    ctx.fill(); ctx.stroke();
    // pixel speckles on dirt face
    ctx.fillStyle = 'rgba(0,0,0,0.18)';
    const speck = s*0.22;
    [[-0.55,0.1],[0.1,0.35],[0.5,-0.05],[-0.15,0.65],[0.6,0.55]].forEach(([px,py])=>{
      ctx.fillRect(px*s-speck/2, py*s-speck/2, speck, speck);
    });
    // top face (grass green), simple parallelogram for a blocky-3D feel
    ctx.beginPath();
    ctx.moveTo(-s, -s*0.35);
    ctx.lineTo(-s*0.55, -s*0.85);
    ctx.lineTo(s*1.0, -s*0.85);
    ctx.lineTo(s, -s*0.35);
    ctx.closePath();
    ctx.fillStyle = '#5a9c3d';
    ctx.strokeStyle = '#2f5a1f';
    ctx.fill(); ctx.stroke();
  }

  function drawGeometryDashIcon(t){
    const s = t.r*0.85;
    ctx.save();
    ctx.rotate(Math.PI/4);
    const grad = ctx.createLinearGradient(-s, -s, s, s);
    grad.addColorStop(0, '#00e1ff');
    grad.addColorStop(1, '#c400ff');
    ctx.fillStyle = grad;
    ctx.strokeStyle = '#1a0d3a';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.rect(-s*0.75, -s*0.75, s*1.5, s*1.5);
    ctx.fill(); ctx.stroke();
    ctx.restore();
    // simple square eyes + spike, drawn unrotated on top
    ctx.fillStyle = '#0a0d10';
    ctx.fillRect(-s*0.32, -s*0.18, s*0.22, s*0.22);
    ctx.fillRect(s*0.1, -s*0.18, s*0.22, s*0.22);
    ctx.beginPath();
    ctx.moveTo(-s*0.18, s*0.2);
    ctx.lineTo(s*0.18, s*0.2);
    ctx.lineTo(0, s*0.42);
    ctx.closePath();
    ctx.fill();
  }

  function drawRobloxFigure(t){
    const s = t.r*0.8;
    ctx.fillStyle = '#e2e2e2';
    ctx.strokeStyle = '#8a8a8a';
    ctx.lineWidth = 2;
    // arms
    ctx.beginPath(); ctx.rect(-s*1.05, -s*0.15, s*0.4, s*0.9); ctx.fill(); ctx.stroke();
    ctx.beginPath(); ctx.rect(s*0.65, -s*0.15, s*0.4, s*0.9); ctx.fill(); ctx.stroke();
    // legs
    ctx.fillStyle = '#3a3a3a';
    ctx.beginPath(); ctx.rect(-s*0.5, s*0.55, s*0.42, s*0.55); ctx.fill(); ctx.stroke();
    ctx.beginPath(); ctx.rect(s*0.08, s*0.55, s*0.42, s*0.55); ctx.fill(); ctx.stroke();
    // torso
    ctx.fillStyle = '#c0392b';
    ctx.beginPath(); ctx.rect(-s*0.62, -s*0.2, s*1.24, s*0.85); ctx.fill(); ctx.stroke();
    // head
    ctx.fillStyle = '#f0c98a';
    ctx.beginPath(); ctx.rect(-s*0.45, -s*1.05, s*0.9, s*0.8); ctx.fill(); ctx.stroke();
  }

  function drawDuckTarget(t, pulse){
    const s = t.r/34;
    const x = t.x, y = t.y;
    ctx.save();
    // ripple ring
    ctx.beginPath();
    ctx.arc(x, y, t.r+10*s, 0, Math.PI*2);
    ctx.strokeStyle = 'rgba(0,212,255,0.25)';
    ctx.lineWidth = 1.5;
    ctx.stroke();
    // body
    ctx.fillStyle = '#ffd23d';
    ctx.strokeStyle = '#c98f00';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.ellipse(x, y+4*s, 20*s, 15*s, 0, 0, Math.PI*2);
    ctx.fill(); ctx.stroke();
    // head
    ctx.beginPath();
    ctx.arc(x+10*s, y-10*s, 11*s, 0, Math.PI*2);
    ctx.fill(); ctx.stroke();
    // beak
    ctx.beginPath();
    ctx.moveTo(x+19*s, y-10*s);
    ctx.lineTo(x+30*s, y-7*s);
    ctx.lineTo(x+19*s, y-4*s);
    ctx.closePath();
    ctx.fillStyle = '#ff6a1a';
    ctx.fill();
    ctx.stroke();
    // eye
    ctx.beginPath();
    ctx.arc(x+13*s, y-13*s, 2*s, 0, Math.PI*2);
    ctx.fillStyle = '#1a0d05';
    ctx.fill();
    // wing detail
    ctx.beginPath();
    ctx.ellipse(x-4*s, y+4*s, 9*s, 6*s, -0.2, 0, Math.PI*2);
    ctx.strokeStyle = 'rgba(201,143,0,0.6)';
    ctx.lineWidth = 1.5;
    ctx.stroke();
    ctx.restore();
  }

  function drawSilhouetteTarget(t, pulse){
    const s = t.r/32;
    const x = t.x, y = t.y;
    ctx.save();
    ctx.beginPath();
    ctx.arc(x, y, t.r+14*s, 0, Math.PI*2);
    ctx.strokeStyle = 'rgba(255,106,26,0.22)';
    ctx.lineWidth = 1.5;
    ctx.stroke();

    ctx.fillStyle = '#20262b';
    ctx.strokeStyle = '#ff6a1a';
    ctx.lineWidth = 2;

    // head
    ctx.beginPath();
    ctx.arc(x, y - 34*s, 11*s, 0, Math.PI*2);
    ctx.fill(); ctx.stroke();

    // shoulders / torso, simple flat outline (range-target style)
    ctx.beginPath();
    ctx.moveTo(x - 9*s, y - 22*s);
    ctx.quadraticCurveTo(x - 22*s, y - 20*s, x - 20*s, y + 4*s);
    ctx.quadraticCurveTo(x - 17*s, y + 30*s, x - 10*s, y + 40*s);
    ctx.lineTo(x + 10*s, y + 40*s);
    ctx.quadraticCurveTo(x + 17*s, y + 30*s, x + 20*s, y + 4*s);
    ctx.quadraticCurveTo(x + 22*s, y - 20*s, x + 9*s, y - 22*s);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();

    // center mark
    ctx.beginPath();
    ctx.arc(x, y, 3, 0, Math.PI*2);
    ctx.fillStyle = '#ff6a1a';
    ctx.fill();

    if(t.lifetime){
      ctx.beginPath();
      ctx.arc(x, y, t.r+14*s, -Math.PI/2, -Math.PI/2 + pulse*Math.PI*2);
      ctx.strokeStyle = 'rgba(232,237,240,0.55)';
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    ctx.font = '600 11px "JetBrains Mono", monospace';
    ctx.textAlign = 'center';
    ctx.fillStyle = '#00d4ff';
    ctx.fillText(t.distance + 'M', x, y - 50*s - 6);
    ctx.restore();
  }

  function renderSceneContent(now){
    // faint grid
    ctx.strokeStyle = 'rgba(232,237,240,0.05)';
    ctx.lineWidth = 1;
    const step = 40;
    for(let x=0;x<canvas.width;x+=step){ ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,canvas.height); ctx.stroke(); }
    for(let y=0;y<canvas.height;y+=step){ ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(canvas.width,y); ctx.stroke(); }

    const isTracking = currentMission.type === 'tracking';
    if(currentMission.type === 'vip'){
      drawVipScene(now);
    } else if(currentMission.type === 'sweep'){
      drawBuildingScene(now);
    } else if(currentMission.type === 'falling'){
      drawFallingScene(now);
    } else if(currentMission.type === 'convoy'){
      drawConvoyScene(now);
    } else {
    targets.forEach(t=>{
      let pulse = 0;
      if(t.lifetime){
        const lifeRatio = 1 - Math.min(1, (now-t.spawnTime)/t.lifetime);
        pulse = lifeRatio;
      }
      if(t.silhouette){
        drawSilhouetteTarget(t, pulse);
        return;
      }
      if(currentMission.easterEgg === 'duck'){
        drawDuckTarget(t, pulse);
        return;
      }
      if(currentMission.easterEgg === 'crossover'){
        drawCrossoverTarget(t, pulse);
        return;
      }
      ctx.beginPath();
      ctx.arc(t.x, t.y, t.r, 0, Math.PI*2);
      ctx.fillStyle = 'rgba(255,106,26,0.14)';
      ctx.fill();
      ctx.lineWidth = 2.5;
      ctx.strokeStyle = isTracking ? '#00d4ff' : '#ff6a1a';
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(t.x, t.y, t.r*0.32, 0, Math.PI*2);
      ctx.fillStyle = isTracking ? '#00d4ff' : '#ff6a1a';
      ctx.fill();
      if(t.lifetime){
        ctx.beginPath();
        ctx.arc(t.x, t.y, t.r+6, -Math.PI/2, -Math.PI/2 + pulse*Math.PI*2);
        ctx.strokeStyle = 'rgba(232,237,240,0.55)';
        ctx.lineWidth = 2;
        ctx.stroke();
      }
    });
    }
  }

  function renderEffectsLayer(now){
    effects = effects.filter(fx => now - fx.time < (fx.text ? 620 : 320));
    effects.forEach(fx=>{
      const dur = fx.text ? 620 : 320;
      const t = (now-fx.time)/dur;
      const alpha = 1-t;
      const rr = fx.big ? (30 + t*70) : (14 + t*22);
      ctx.beginPath();
      ctx.arc(fx.x, fx.y, rr, 0, Math.PI*2);
      ctx.strokeStyle = fx.color==='success' ? `rgba(57,255,136,${alpha})` : `rgba(255,59,78,${alpha})`;
      ctx.lineWidth = fx.big ? 4 : 3;
      ctx.stroke();
      if(fx.big){
        ctx.beginPath();
        ctx.arc(fx.x, fx.y, rr*0.6, 0, Math.PI*2);
        ctx.strokeStyle = `rgba(255,106,26,${alpha*0.8})`;
        ctx.lineWidth = 2;
        ctx.stroke();
      }
      if(fx.text){
        ctx.font = '600 15px "JetBrains Mono", monospace';
        ctx.textAlign = 'center';
        ctx.fillStyle = fx.color==='success' ? `rgba(57,255,136,${alpha})` : `rgba(255,59,78,${alpha})`;
        ctx.fillText(fx.text, fx.x, fx.y - 26 - t*18);
      }
    });
  }

  function drawScopeOverlay(lensR){
    const x = mouse.x, y = mouse.y;
    // bezel
    ctx.beginPath();
    ctx.arc(x, y, lensR+3, 0, Math.PI*2);
    ctx.strokeStyle = '#0a0d10';
    ctx.lineWidth = 10;
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(x, y, lensR, 0, Math.PI*2);
    ctx.strokeStyle = 'rgba(232,237,240,0.55)';
    ctx.lineWidth = 2;
    ctx.stroke();
    // crosshair across the lens
    ctx.save();
    ctx.beginPath();
    ctx.arc(x, y, lensR, 0, Math.PI*2);
    ctx.clip();
    ctx.strokeStyle = 'rgba(57,255,136,0.75)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x-lensR, y); ctx.lineTo(x+lensR, y);
    ctx.moveTo(x, y-lensR); ctx.lineTo(x, y+lensR);
    ctx.stroke();
    // mil-dot ticks
    for(let d=-3; d<=3; d++){
      if(d===0) continue;
      const off = d*(lensR/4);
      ctx.beginPath();
      ctx.arc(x+off, y, 2, 0, Math.PI*2);
      ctx.arc(x, y+off, 2, 0, Math.PI*2);
      ctx.fillStyle = 'rgba(57,255,136,0.75)';
      ctx.fill();
    }
    ctx.restore();
    // center dot
    ctx.beginPath();
    ctx.arc(x, y, 2.5, 0, Math.PI*2);
    ctx.fillStyle = '#39ff88';
    ctx.fill();
  }

  function draw(now){
    ctx.clearRect(0,0,canvas.width,canvas.height);

    const canScope = !!(currentMission && currentMission.scope);
    const isScoped = canScope && scoped && mouse.x > -50;

    if(isScoped){
      // scope tube background
      ctx.fillStyle = '#05070a';
      ctx.fillRect(0,0,canvas.width,canvas.height);
      const lensR = Math.max(90, Math.min(canvas.width, canvas.height) * 0.3);
      const zoom = 2.3;
      ctx.save();
      ctx.beginPath();
      ctx.arc(mouse.x, mouse.y, lensR, 0, Math.PI*2);
      ctx.clip();
      ctx.translate(mouse.x, mouse.y);
      ctx.scale(zoom, zoom);
      ctx.translate(-mouse.x, -mouse.y);
      renderSceneContent(now);
      renderEffectsLayer(now);
      ctx.restore();
      drawScopeOverlay(lensR);
    } else {
      renderSceneContent(now);
      renderEffectsLayer(now);

      // plain crosshair reticle at cursor
      if(mouse.x > -50){
        ctx.strokeStyle = 'rgba(232,237,240,0.85)';
        ctx.lineWidth = 1.5;
        const size = 14;
        ctx.beginPath();
        ctx.moveTo(mouse.x-size, mouse.y); ctx.lineTo(mouse.x-4, mouse.y);
        ctx.moveTo(mouse.x+4, mouse.y); ctx.lineTo(mouse.x+size, mouse.y);
        ctx.moveTo(mouse.x, mouse.y-size); ctx.lineTo(mouse.x, mouse.y-4);
        ctx.moveTo(mouse.x, mouse.y+4); ctx.lineTo(mouse.x, mouse.y+size);
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(mouse.x, mouse.y, 2, 0, Math.PI*2);
        ctx.fillStyle = 'rgba(232,237,240,0.9)';
        ctx.fill();
      }
      if(canScope){
        ctx.font = '600 12px "JetBrains Mono", monospace';
        ctx.textAlign = 'center';
        ctx.fillStyle = 'rgba(232,237,240,0.5)';
        ctx.fillText('HOLD SPACE (OR RIGHT-CLICK) TO SCOPE IN', canvas.width/2, canvas.height-16);
      }
    }
  }

  function finishMission(){
    stopMission();
    if(['vip','sweep','convoy'].includes(currentMission.type) && missionOutcome !== 'win'){
      missionOutcome = 'fail';
      if(!missionFailReason) missionFailReason = 'TIME EXPIRED';
    }
    if(currentMission.type === 'holdout' && missionOutcome !== 'fail'){
      missionOutcome = holdoutLives > 0 ? 'win' : 'fail';
      if(missionOutcome === 'fail' && !missionFailReason) missionFailReason = 'OVERRUN';
    }
    if(['vip','sweep','convoy','holdout'].includes(currentMission.type)){
      if(missionOutcome === 'win') AudioEngine.win(); else AudioEngine.fail();
    }
    if(sessionBest[currentMission.id] === undefined || score > sessionBest[currentMission.id]){
      sessionBest[currentMission.id] = score;
    }

    // quest trackers
    if(currentMission.category === 'training'){
      trainingCompleted.add(currentMission.id);
    }
    if(['vip','sweep','convoy','holdout'].includes(currentMission.type) && missionOutcome === 'win'){
      missionWon[currentMission.id] = true;
      const remainingMs = Math.max(0, currentMission.duration*1000 - (performance.now() - missionStartTime));
      missionWinRemaining[currentMission.id] = Math.max(missionWinRemaining[currentMission.id]||0, remainingMs);
      if(currentMission.id === 'hvt' && boxesUsed === 0){
        hvtWinNoCharges = true;
      }
    }
    if(currentMission.type === 'tracking'){
      const lockPct = totalTrackTime>0 ? Math.round((lockTime/totalTrackTime)*100) : 0;
      trackingBestLockPct = Math.max(trackingBestLockPct, lockPct);
    }
    if(currentMission.type === 'falling' && fallingHitsCount === FALLING_TOTAL){
      fallingPerfectAchieved = true;
      const avgReact = reactionTimes.length ? reactionTimes.reduce((a,b)=>a+b,0)/reactionTimes.length : 9999;
      if(avgReact < 480){ fallingFlawlessFast = true; }
    }

    const isMissionRun = currentMission.category === 'mission';
    let xpGain = Math.round(score / (isMissionRun ? 6 : 10));
    if(isMissionRun){
      xpGain += missionOutcome === 'win' ? 150 : 20;
    } else {
      xpGain += 40;
    }
    addXP(xpGain);
    lastXpGain = xpGain;
    evaluateQuests();
    showResults();
  }

  function grade(pct){
    if(pct >= 90) return 'S';
    if(pct >= 75) return 'A';
    if(pct >= 60) return 'B';
    if(pct >= 40) return 'C';
    return 'D';
  }

  function showResults(){
    const statsEl = document.getElementById('resultsStats');
    statsEl.innerHTML = '';
    let gradePct;

    function addStat(label, value){
      const div = document.createElement('div');
      div.className = 'stat-row';
      div.innerHTML = `<span class="label">${label}</span><span class="value">${value}</span>`;
      statsEl.appendChild(div);
    }

    if(currentMission.type === 'vip'){
      const won = missionOutcome === 'win';
      document.getElementById('resultMissionName').textContent = currentMission.name + (won ? ' — TARGET ELIMINATED' : ' — MISSION FAILED');
      addStat('RESULT', won ? 'SUCCESS' : (missionFailReason || 'FAILED'));
      addStat('SCORE', score);
      addStat('GUARDS DOWN', guardsEliminated + ' / 4');
      addStat('CHARGES USED', boxesUsed);
      addStat('XP EARNED', '+'+lastXpGain);
      document.getElementById('gradeBadge').textContent = won ? grade(60 + guardsEliminated*10) : 'F';
      showScreen('results');
      return;
    }

    if(currentMission.type === 'sweep'){
      const won = missionOutcome === 'win';
      document.getElementById('resultMissionName').textContent = currentMission.name + (won ? ' — TARGET ELIMINATED' : ' — MISSION FAILED');
      addStat('RESULT', won ? 'SUCCESS' : (missionFailReason || 'FAILED'));
      addStat('SCORE', score);
      addStat('XP EARNED', '+'+lastXpGain);
      document.getElementById('gradeBadge').textContent = won ? 'S' : 'F';
      showScreen('results');
      return;
    }

    if(currentMission.type === 'convoy'){
      const won = missionOutcome === 'win';
      document.getElementById('resultMissionName').textContent = currentMission.name + (won ? ' — TARGET ELIMINATED' : ' — MISSION FAILED');
      addStat('RESULT', won ? 'SUCCESS' : (missionFailReason || 'FAILED'));
      addStat('SCORE', score);
      addStat('XP EARNED', '+'+lastXpGain);
      document.getElementById('gradeBadge').textContent = won ? 'S' : 'F';
      showScreen('results');
      return;
    }

    if(currentMission.type === 'holdout'){
      const won = missionOutcome === 'win';
      document.getElementById('resultMissionName').textContent = currentMission.name + (won ? ' — POSITION HELD' : ' — OVERRUN');
      addStat('RESULT', won ? 'SUCCESS' : (missionFailReason || 'FAILED'));
      addStat('SCORE', score);
      addStat('WAVE REACHED', holdoutWave);
      addStat('LIVES LEFT', Math.max(0, holdoutLives));
      addStat('XP EARNED', '+'+lastXpGain);
      document.getElementById('gradeBadge').textContent = won ? grade(50 + holdoutWave*8) : 'F';
      showScreen('results');
      return;
    }

    document.getElementById('resultMissionName').textContent = currentMission.name + ' — COMPLETE';

    if(currentMission.type === 'tracking'){
      const lockPct = totalTrackTime>0 ? Math.round((lockTime/totalTrackTime)*100) : 0;
      gradePct = lockPct;
      addStat('LOCK TIME', lockPct+'%');
      addStat('SCORE', score);
      addStat('XP EARNED', '+'+lastXpGain);
      addStat('SECONDS TRACKED', (totalTrackTime/1000).toFixed(1)+'s');
      addStat('SECONDS LOCKED', (lockTime/1000).toFixed(1)+'s');
    } else {
      const total = hits+misses;
      const acc = total>0 ? Math.round((hits/total)*100) : 0;
      gradePct = acc;
      const avgReact = reactionTimes.length ? Math.round(reactionTimes.reduce((a,b)=>a+b,0)/reactionTimes.length) : 0;
      addStat('SCORE', score);
      addStat('XP EARNED', '+'+lastXpGain);
      addStat('ACCURACY', acc+'%');
      addStat('HITS', hits);
      addStat('MISSES', misses);
      addStat('AVG REACTION', avgReact+'ms');
      addStat('BEST STREAK', bestStreak);
    }

    const finalGrade = grade(gradePct);
    document.getElementById('gradeBadge').textContent = finalGrade;
    if(finalGrade === 'S' && Math.random() < 0.35){
      queueToast('S RANK. THE DUCKS ARE PROUD.');
    }
    showScreen('results');
  }

})();
</script>
