<script>
(function(){
  "use strict";

  // ---------------- Screen management ----------------
  const screens = {
    intro: document.getElementById('screen-intro'),
    hub: document.getElementById('screen-hub'),
    game: document.getElementById('screen-game'),
    results: document.getElementById('screen-results'),
  };
  function showScreen(name){
    Object.values(screens).forEach(s=>s.classList.remove('active'));
    screens[name].classList.add('active');
  }

  // ---------------- Audio engine (synthesized, no asset files) ----------------
  const AudioEngine = (function(){
    let ctx = null;
    let muted = false;
    function ensureCtx(){
      if(!ctx){
        try{ ctx = new (window.AudioContext || window.webkitAudioContext)(); }catch(e){ ctx = null; }
      }
      if(ctx && ctx.state === 'suspended'){ ctx.resume(); }
      return ctx;
    }
    function tone(freq, dur, type, peak, delay, freqTo){
      if(muted) return;
      const c = ensureCtx();
      if(!c) return;
      const t0 = c.currentTime + (delay||0);
      const osc = c.createOscillator();
      const gain = c.createGain();
      osc.type = type || 'sine';
      osc.frequency.setValueAtTime(freq, t0);
      if(freqTo) osc.frequency.exponentialRampToValueAtTime(Math.max(1,freqTo), t0+dur);
      gain.gain.setValueAtTime(0.0001, t0);
      gain.gain.linearRampToValueAtTime(peak!=null?peak:0.2, t0+0.012);
      gain.gain.exponentialRampToValueAtTime(0.0001, t0+dur);
      osc.connect(gain).connect(c.destination);
      osc.start(t0);
      osc.stop(t0+dur+0.03);
    }
    function noiseBurst(dur, peak, delay){
      if(muted) return;
      const c = ensureCtx();
      if(!c) return;
      const t0 = c.currentTime + (delay||0);
      const bufferSize = Math.max(1, Math.floor(c.sampleRate * dur));
      const buffer = c.createBuffer(1, bufferSize, c.sampleRate);
      const data = buffer.getChannelData(0);
      for(let i=0;i<bufferSize;i++){ data[i] = (Math.random()*2-1) * (1 - i/bufferSize); }
      const src = c.createBufferSource();
      src.buffer = buffer;
      const gain = c.createGain();
      gain.gain.setValueAtTime(peak!=null?peak:0.3, t0);
      gain.gain.exponentialRampToValueAtTime(0.0001, t0+dur);
      const filter = c.createBiquadFilter();
      filter.type = 'highpass';
      filter.frequency.value = 1100;
      src.connect(filter).connect(gain).connect(c.destination);
      src.start(t0);
    }
    return {
      unlock(){ ensureCtx(); },
      setMuted(v){ muted = v; },
      isMuted(){ return muted; },
      shot(){ noiseBurst(0.09, 0.32); tone(170, 0.08, 'square', 0.14, 0, 75); },
      hit(){ tone(660, 0.08, 'triangle', 0.2, 0, 900); tone(1000, 0.1, 'triangle', 0.13, 0.05); },
      miss(){ tone(220, 0.16, 'sawtooth', 0.15, 0, 110); },
      caught(){ tone(190, 0.2, 'square', 0.2, 0, 90); tone(150, 0.22, 'square', 0.16, 0.1, 60); },
      countdown(){ tone(440, 0.07, 'square', 0.13); },
      go(){ tone(880, 0.14, 'square', 0.18, 0, 1250); },
      win(){ tone(523, 0.11, 'triangle', 0.18); tone(659, 0.11, 'triangle', 0.18, 0.1); tone(784, 0.2, 'triangle', 0.2, 0.2); },
      fail(){ tone(160, 0.3, 'sawtooth', 0.18, 0, 55); },
      levelUp(){ tone(523,0.09,'square',0.16); tone(659,0.09,'square',0.16,0.09); tone(784,0.09,'square',0.16,0.18); tone(1046,0.15,'square',0.18,0.27); },
      quest(){ tone(784, 0.1, 'triangle', 0.16); tone(988, 0.14, 'triangle', 0.18, 0.1); },
      easterEgg(){
        tone(392,0.08,'square',0.16); tone(494,0.08,'square',0.16,0.08);
        tone(587,0.08,'square',0.16,0.16); tone(784,0.08,'square',0.16,0.24);
        tone(220,0.12,'sawtooth',0.14,0.34,660); tone(220,0.12,'sawtooth',0.14,0.46,660);
      },
      horrorShot(){
        tone(58, 0.55, 'sawtooth', 0.16, 0, 42);
        tone(1500, 0.45, 'sine', 0.05, 0.06, 2600);
        noiseBurst(0.28, 0.28, 0.08);
        tone(130, 0.35, 'square', 0.12, 0.16, 48);
      },
      birthdayNote(freq){
        tone(freq, 0.24, 'triangle', 0.22);
        tone(freq*2, 0.18, 'sine', 0.06, 0.02);
      },
      click(){ tone(1000, 0.03, 'square', 0.05); }
    };
  })();
  document.addEventListener('pointerdown', ()=> AudioEngine.unlock(), {once:true});

  // ---------------- Boot log (intro) ----------------
  const bootLines = [
    "INIT RETICLE SUBSYSTEM ... <span class='ok'>OK</span>",
    "LOADING SENSOR ARRAY ... <span class='ok'>OK</span>",
    "CALIBRATING TARGET GRID ... <span class='ok'>OK</span>",
    "RANGE SAFETY CHECK ... <span class='ok'>CLEAR</span>",
    "STANDING BY FOR OPERATOR"
  ];
  const bootLog = document.getElementById('bootLog');
  const trainingEntryBtn = document.getElementById('trainingEntryBtn');
  const missionsEntryBtn = document.getElementById('missionsEntryBtn');
  const questsEntryBtn = document.getElementById('questsEntryBtn');
  bootLines.forEach((line, i)=>{
    const div = document.createElement('div');
    div.innerHTML = "&gt; " + line;
    div.style.animationDelay = (i*0.35)+"s";
    bootLog.appendChild(div);
  });
  setTimeout(()=>{ trainingEntryBtn.disabled = false; missionsEntryBtn.disabled = false; questsEntryBtn.disabled = false; }, bootLines.length*350 + 200);
  const hubTabPanels = {
    training: document.getElementById('hubTrainingSection'),
    missions: document.getElementById('hubMissionsSection'),
    quests: document.getElementById('hubQuestsSection'),
  };
  const hubTabBtns = {
    training: document.getElementById('tabBtnTraining'),
    missions: document.getElementById('tabBtnMissions'),
    quests: document.getElementById('tabBtnQuests'),
  };
  function showHubTab(tab){
    Object.keys(hubTabPanels).forEach(k=>{
      hubTabPanels[k].classList.toggle('active', k === tab);
      hubTabBtns[k].classList.toggle('active', k === tab);
    });
  }
  Object.keys(hubTabBtns).forEach(tab=>{
    hubTabBtns[tab].addEventListener('click', ()=> showHubTab(tab));
  });

  let hasSeenTutorial = false;
  function enterHub(tab){
    renderHub();
    showScreen('hub');
    showHubTab(tab || 'training');
    if(!hasSeenTutorial){
      hasSeenTutorial = true;
      openTutorial();
    }
  }
  trainingEntryBtn.addEventListener('click', ()=> enterHub('training'));
  missionsEntryBtn.addEventListener('click', ()=> enterHub('missions'));
  questsEntryBtn.addEventListener('click', ()=> enterHub('quests'));

  // ---------------- Tutorial ----------------
  const helpBtn = document.getElementById('helpBtn');
  const tutorialOverlay = document.getElementById('tutorialOverlay');
  function openTutorial(){ tutorialOverlay.classList.add('show'); }
  function closeTutorial(){ tutorialOverlay.classList.remove('show'); }
  helpBtn.addEventListener('click', openTutorial);
  document.getElementById('tutorialCloseBtn').addEventListener('click', closeTutorial);
  document.getElementById('tutorialGotItBtn').addEventListener('click', closeTutorial);
  tutorialOverlay.addEventListener('click', (e)=>{ if(e.target === tutorialOverlay) closeTutorial(); });

  // ---------------- Mission config ----------------
  const DIFFICULTIES = [
    { id:'xeasy', label:'EXTRA EASY', hint:'Huge, slow, generous clock', sizeMult:1.55, speedMult:0.55, timeMult:1.6 },
    { id:'easy', label:'EASY', hint:'Bigger marks, more time', sizeMult:1.25, speedMult:0.78, timeMult:1.25 },
    { id:'medium', label:'MEDIUM', hint:'Standard issue', sizeMult:1.0, speedMult:1.0, timeMult:1.0 },
    { id:'hard', label:'HARD', hint:'Smaller, faster, tighter clock', sizeMult:0.8, speedMult:1.25, timeMult:0.85 },
    { id:'extreme', label:'EXTREME', hint:'Pinpoint marks, no mercy', sizeMult:0.6, speedMult:1.55, timeMult:0.68 },
  ];

  const XEASY_TAUNTS = [
    "Targets the size of barn doors, half speed, extra time on the clock. Nobody has to know.",
    "This is the training-wheels setting. The targets can practically see themselves.",
    "We enlarged the targets so much they can be seen from space. Still want this?",
    "Extra Easy: because sometimes a person just needs a participation trophy.",
    "At this setting the targets basically walk into your crosshair for you.",
    "Bold of you to pick the mode where the targets move slower than you do.",
  ];
  function randomTaunt(){
    return XEASY_TAUNTS[Math.floor(Math.random()*XEASY_TAUNTS.length)];
  }

  const MISSIONS = [
    {
      id:'static', code:'OP 01', name:'STATIC RANGE', type:'static', duration:30, category:'training',
      desc:'Stationary marks. One at a time. Pure precision — no clock pressure beyond the run itself.',
      hint:'Click each target as it appears. Every miss breaks your streak.'
    },
    {
      id:'flick', code:'OP 02', name:'FLICK SHOT', type:'flick', duration:25, category:'training',
      desc:'Marks vanish fast. React before the window closes or the target is lost.',
      hint:'Fast reflexes score bonus points. Don\u2019t hesitate.'
    },
    {
      id:'tracking', code:'OP 03', name:'TRACKING LOCK', type:'tracking', duration:20, category:'training',
      desc:'One mark, always moving. Keep the reticle glued to it to build lock time.',
      hint:'No clicking — just hover and hold your lock as it drifts.'
    },
    {
      id:'gridrush', code:'OP 04', name:'GRID RUSH', type:'gridrush', duration:30, category:'training',
      desc:'Three marks live at once, each on a short fuse. Clear the grid before it clears you.',
      hint:'Prioritize the mark closest to expiring.'
    },
    {
      id:'longrange', code:'OP 05', name:'LONG RANGE', type:'longrange', duration:35, category:'training',
      desc:'Silhouette targets appear far downrange. The farther the shot, the smaller the mark — and the bigger the payout.',
      hint:'Range is shown above each silhouette. Farther shots score more, but the window is short.'
    },
    {
      id:'hvt', code:'MSN 01', name:'HIGH VALUE TARGET', type:'vip', duration:10, category:'mission', hardcore:true, scope:true,
      desc:'A protected target is holding position downrange, surrounded by guards. One missed shot and you\u2019re made — the mission ends. The target only goes down on a clean scoped headshot.',
      hint:'Hold SPACE (or right-click) to look through the scope, then fire. No margin for error: any shot that isn\u2019t a hit gets you caught.'
    },
    {
      id:'sweep', code:'MSN 02', name:'BUILDING SWEEP', type:'sweep', duration:25, category:'mission', hardcore:true,
      desc:'The target is walking through a three-story building, floor to floor, only visible while passing a window. Two guards patrol the same floors — shoot the wrong silhouette and you\u2019re caught.',
      hint:'Track the windows and confirm who you\u2019re looking at before you fire. The target is gold, guards are red — anything else gets you caught.'
    },
    {
      id:'convoy', code:'MSN 03', name:'CONVOY', type:'convoy', duration:40, category:'mission', hardcore:true,
      desc:'You\u2019re set up at street level, watching the convoy roll past side-on. One of them carries the target — bystanders ride in the others, and you only get a look at whoever\u2019s in the window for a moment.',
      hint:'Wait for a face at the window before you commit. Hit the wrong car and it\u2019s over — hit no one and the target gets away.'
    },
    {
      id:'holdout', code:'MSN 04', name:'LAST STAND', type:'holdout', duration:60, category:'mission',
      desc:'They keep coming, wave after wave. Every target that reaches the end of its window and isn\u2019t taken down costs you a life. Lose all three and the position falls.',
      hint:'Missed shots don\u2019t end the run — only letting a target expire does. Prioritize whichever is about to time out. You have three lives.'
    },
    {
      id:'falling', code:'OP 06', name:'FALLING TARGETS', type:'falling', duration:75, category:'training',
      desc:'Thirty targets drop from above, one at a time. You get exactly one shot at each — hit or miss, it\u2019s gone before the next one falls.',
      hint:'One shot per target, no do-overs. Watch it drop, commit to the shot.'
    },
    {
      id:'duckrange', code:'??? ', name:'RUBBER DUCK RANGE', type:'static', duration:30, category:'training', hidden:true, easterEgg:'duck',
      desc:'A classified range. Nobody can explain why the targets look like this.',
      hint:'Click the ducks. Just... click the ducks.'
    },
    {
      id:'crossover', code:'??? ', name:'GAME OVER', type:'flick', duration:30, category:'training', hidden:true, easterEgg:'crossover',
      desc:'A classified crossover event. The competition has arrived. Eliminate it.',
      hint:'They vanish fast. Show them who the best game really is.'
