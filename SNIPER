    }
    const uname = loginUsernameInput.value.trim().toUpperCase();
    if(!uname){
      loginErrorEl.textContent = 'TYPE AN OPERATOR NAME.';
      return;
    }
    if(!(uname in ACCOUNTS)){
      loginErrorEl.textContent = 'UNKNOWN OPERATOR.';
      AudioEngine.unlock(); AudioEngine.miss();
      return;
    }
    if(loginPasswordEl.value !== ACCOUNTS[uname]){
